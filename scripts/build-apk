#!/usr/bin/env bash
# Android build driver.
#
# HONEST STATUS: this has never been run. No device has been connected to this
# project and `pyside6-android-deploy` has never been invoked from it. What
# follows is a checked, ordered driver for the steps in docs/android.md — it
# verifies preconditions properly and fails loudly, but the build command at the
# end is the part you will be debugging, not the part that is known to work.
#
#   nix run .#android-shell      # FHS env — REQUIRED, this will not work outside it
#   ./scripts/build-apk
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

VENV="${ROOT}/.venv-android"
KEYSTORE="${ROOT}/mycu-release.keystore"

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }
die()  { printf '\033[31merror:\033[0m %s\n' "$1" >&2; exit 1; }

# --- Preconditions ----------------------------------------------------------

step "Checking preconditions"

# The FHS env sets BUILDOZER_HOME; nothing else does. This is the single most
# common way to get a confusing failure 20 minutes into a build.
[[ -n "${BUILDOZER_HOME:-}" ]] || die \
  "not inside the Android FHS shell. Run 'nix run .#android-shell' first.
   buildozer and python-for-android need an FHS layout; the plain devShell
   cannot provide one. See docs/android.md."

command -v java >/dev/null || die "no JDK on PATH (expected inside the FHS env)"
command -v adb  >/dev/null || die \
  "adb not found. Add to /etc/nixos/configuration.nix:
       programs.adb.enable = true;
       users.users.\"kroma\".extraGroups = [ ... \"adbusers\" ];
   then 'sudo nixos-rebuild switch --flake /etc/nixos#nixos' AND LOG OUT AND BACK IN."

if ! adb devices | tail -n +2 | grep -q device; then
  printf '\033[33mwarning:\033[0m no device visible to adb. The APK will still\n'
  printf '         build; you just will not be able to install it.\n'
fi

echo "ok"

# --- Toolchain --------------------------------------------------------------

if [[ ! -d "$VENV" ]]; then
  step "Creating the Android build venv (this downloads ~1 GB)"
  python -m venv "$VENV"
  # shellcheck disable=SC1091
  source "$VENV/bin/activate"
  pip install --upgrade pip
  # Must match the desktop Qt version in flake.nix (6.11.x) or the QML will be
  # compiled against a different Qt than it runs on.
  pip install "pyside6==6.11.0" --no-cache-dir
else
  # shellcheck disable=SC1091
  source "$VENV/bin/activate"
fi

command -v pyside6-android-deploy >/dev/null || die \
  "pyside6-android-deploy is still not on PATH after installing the wheel.
   It is not packaged in nixpkgs and only ships in the PyPI wheels."

# --- Signing ----------------------------------------------------------------

if [[ ! -f "$KEYSTORE" ]]; then
  step "No release keystore found"
  cat <<'EOF'
Generate one:

    keytool -genkey -v -keystore mycu-release.keystore \
            -alias mycu -keyalg RSA -keysize 4096 -validity 10000

It is gitignored. BACK IT UP OUTSIDE THIS REPO — it is not recoverable, and
losing it means you can never upgrade an already-installed build in place.

Continuing with a debug-signed APK, which is fine for your own phone.
EOF
fi

# --- Build ------------------------------------------------------------------

step "Building"
cat <<'EOF'
Modules this app needs bundled beyond the defaults:

    QtWebView        <- without it there is no login and no transport
    QtQuick QtQuickControls2 QtQml QtNetwork

Do NOT bundle QtWebEngine; it does not exist on Android.

If M0 showed the chapel page is JSON, delete the HTML branch from
mycu/core/providers/chapel.py and drop lxml from pyproject.toml first — lxml is
a C extension and needs a python-for-android recipe. Avoiding it entirely is a
much shorter path than making it cross-compile.
EOF

set -x
pyside6-android-deploy \
  --name mycu \
  --init            # writes pysidedeploy.spec — EDIT IT, then re-run without --init
set +x

cat <<'EOF'

Now edit pysidedeploy.spec:
  - add QtWebView to the modules list
  - check `permissions` is INTERNET and nothing more
  - point `qml_files` at mycu/ui/qml

Then re-run this script (it will skip --init once the spec exists), and:

    adb install -r mycu.apk
    adb logcat -c && adb logcat | grep -iE 'python|qml|mycu'

Things flagged for on-device verification are marked '# VERIFY:' in the source
and listed in docs/android.md.
EOF
