# ---------------------------------------------------------------------------
# Structural reporting
# ---------------------------------------------------------------------------

def describe_json(node, show_values: bool, depth: int = 0, max_depth: int = 6) -> str:
    """Render a JSON value as a shape, with the values redacted by default."""
    pad = "  " * depth
    if depth > max_depth:
        return "…"

    if isinstance(node, dict):
        if not node:
            return "{}"
        lines = ["{"]
        for key, value in list(node.items())[:40]:
            lines.append(f"{pad}  {key!r}: {describe_json(value, show_values, depth + 1)}")
        if len(node) > 40:
            lines.append(f"{pad}  … {len(node) - 40} more keys")
        lines.append(pad + "}")
        return "\n".join(lines)

    if isinstance(node, list):
        if not node:
            return "[]  (empty)"
        head = describe_json(node[0], show_values, depth + 1)
        return f"[  x{len(node)}\n{pad}  {head}\n{pad}]"

    if show_values:
        return repr(node)

    if node is None:
        return "null"
    if isinstance(node, bool):
        return "<bool>"
    if isinstance(node, int):
        return "<int>"
    if isinstance(node, float):
        return "<float>"

    text = str(node)
    # A bare run of digits is an ID (student, prox card) far more often than a
    # date, so it is masked; a real date has a separator in it.
    if re.fullmatch(r"\d{4,}", text):
        return f"<digits len={len(text)}>"
    # Date-ish and short enumerated strings are shape, not secrets, and they are
    # exactly what a parser needs to know. Everything longer is masked.
    if (re.fullmatch(r"(?=.*[/:\-])[\d/:\-T+. ]{6,32}Z?", text)
            or re.fullmatch(r"/Date\(-?\d+\)/", text)):
        return f'"{text}"   <- date-ish'
    if len(text) <= 24:
        return f'"{text}"'
    return f"<str len={len(text)}>"


def describe_html(body: str, show_values: bool) -> str:
    """Summarise a server-rendered page: its tables, headers and labelled numbers."""
    try:
        from lxml import etree
        from lxml import html as lxml_html
    except ImportError:
        return "(lxml unavailable)"

    try:
        tree = lxml_html.fromstring(body)
    except (etree.ParserError, ValueError) as exc:
        return f"(not parseable as HTML: {exc})"
    out: list[str] = []

    tables = tree.xpath("//table")
    out.append(f"{len(tables)} <table> element(s)")
    for n, table in enumerate(tables[:8]):
        headers = [_text(th) for th in table.xpath(".//th")]
        rows = table.xpath(".//tbody/tr") or table.xpath(".//tr")
        out.append(f"\n  table[{n}]  id={table.get('id')!r} class={table.get('class')!r}")
        out.append(f"    headers: {headers}")
        out.append(f"    rows: {len(rows)}")

        body_rows = [r for r in rows if r.xpath("./td")]
        if body_rows:
            cells = [_text(td) for td in body_rows[0].xpath("./td")]
            if show_values:
                out.append(f"    first row: {cells}")
            else:
                out.append(f"    first row: {[_mask(c) for c in cells]}")
            # The vocabulary of short repeated cell values is exactly what a
            # status column looks like, and it is what a parser must map.
            for col in range(len(cells)):
                values = {
                    _text(r.xpath("./td")[col])
                    for r in body_rows
                    if len(r.xpath("./td")) > col
                }
                short = {v for v in values if 0 < len(v) <= 20}
                if short and len(short) <= 8:
                    out.append(f"    col[{col}] distinct values: {sorted(short)}")

    page_text = _text(tree)
    labelled = re.findall(
        r"([A-Za-z][A-Za-z ]{2,28}?)\s*[:=]?\s*\$?(\d[\d,]*\.?\d*)", page_text
    )
    if labelled:
        out.append("\n  labelled numbers on the page:")
        for label, value in labelled[:25]:
            shown = value if show_values else "<num>"
            out.append(f"    {label.strip()!r} -> {shown}")

    forms = tree.xpath("//form")
    if forms:
        out.append(f"\n  {len(forms)} form(s):")
        for form in forms[:5]:
            names = [i.get("name") for i in form.xpath(".//input") if i.get("name")]
            out.append(f"    action={form.get('action')!r} inputs={names}")

    return "\n".join(out)


def _text(node) -> str:
    return re.sub(r"\s+", " ", node.text_content()).strip()


def _mask(value: str) -> str:
    if not value:
        return ""
    if re.fullmatch(r"(?=.*[/:\-])[\d/:\-. ]{4,}", value):
        return value            # dates are structure; bare digits are IDs
    return f"<{len(value)} chars>"


# ---------------------------------------------------------------------------
# Network recorder
# ---------------------------------------------------------------------------

#: Injected at DocumentCreation into the page's own JavaScript world, in every
#: frame, before any of the page's scripts run. It has to be the main world
#: rather than an isolated one: the point is to wrap the *page's* ``fetch`` and
#: ``XMLHttpRequest``, and an isolated world has its own copies of both.
#:
#: Records queue on ``window.__mycuNet`` in the top frame (a same-origin
#: subframe pushes to its parent's queue) and Python drains them every
#: :data:`DRAIN_INTERVAL_MS`. Anything still queued when the page unloads is
#: carried over in sessionStorage, so a form POST or redirect between two
#: drains does not lose the request that caused it.
NET_RECORDER_JS = r"""
(function () {
  if (window.__mycuNetInstalled) { return; }
  window.__mycuNetInstalled = true;

  var MAX = 2 * 1024 * 1024;
  var CARRY = '__mycuNetCarry';
  var isTop = window.top === window;

  window.__mycuNet = [];
  if (isTop) {
    try {
      var carried = sessionStorage.getItem(CARRY);
      if (carried) {
        sessionStorage.removeItem(CARRY);
        window.__mycuNet = JSON.parse(carried) || [];
      }
    } catch (e) {}
    window.addEventListener('pagehide', function () {
      try {
        if (window.__mycuNet.length) {
          sessionStorage.setItem(CARRY, JSON.stringify(window.__mycuNet));
        }
      } catch (e) {}
    });
  }

  function push(rec) {
    rec.page = String(location.href);
    rec.frame = isTop ? 'top' : 'sub';
    try {
      if (!isTop && window.top.__mycuNet) { window.top.__mycuNet.push(rec); return; }
    } catch (e) { /* cross-origin parent: keep it local */ }
    window.__mycuNet.push(rec);
  }

  function abs(url) {
    try { return new URL(String(url), location.href).href; } catch (e) { return String(url); }
  }

  function cap(t) {
    if (t == null) { return null; }
    t = String(t);
    return t.length > MAX ? t.slice(0, MAX) + '\n<truncated, ' + t.length + ' chars>' : t;
  }

  function ser(b) {
    if (b == null) { return null; }
    if (typeof b === 'string') { return b; }
    try {
      if (b instanceof URLSearchParams) { return b.toString(); }
      if (typeof FormData !== 'undefined' && b instanceof FormData) {
        var parts = [];
        b.forEach(function (v, k) {
          parts.push(encodeURIComponent(k) + '=' + encodeURIComponent(
            typeof v === 'string' ? v : '<file ' + (v.name || '') + '>'));
        });
        return parts.join('&');
      }
      if (typeof Blob !== 'undefined' && b instanceof Blob) { return '<binary ' + b.size + ' bytes>'; }
      if (b instanceof ArrayBuffer || ArrayBuffer.isView(b)) { return '<binary ' + b.byteLength + ' bytes>'; }
      if (typeof Document !== 'undefined' && b instanceof Document) {
        return new XMLSerializer().serializeToString(b);
      }
    } catch (e) {}
    return String(b);
  }

  function hdrs(h) {
    var out = [];
    if (!h) { return out; }
    try {
      if (typeof Headers !== 'undefined' && h instanceof Headers) {
        h.forEach(function (v, k) { out.push({name: k, value: v}); });
      } else if (Array.isArray(h)) {
        h.forEach(function (p) { out.push({name: String(p[0]), value: String(p[1])}); });
      } else {
        Object.keys(h).forEach(function (k) { out.push({name: k, value: String(h[k])}); });
      }
    } catch (e) {}
    return out;
  }

  function rawHdrs(s) {
    return String(s || '').trim().split(/[\r\n]+/).filter(Boolean).map(function (line) {
      var i = line.indexOf(':');
      return {name: line.slice(0, i).trim(), value: line.slice(i + 1).trim()};
    });
  }

  // --- fetch -------------------------------------------------------------
  var origFetch = window.fetch;
  if (origFetch) {
    window.fetch = function (input, init) {
      var t0 = Date.now();
      var rec = {kind: 'fetch', started: new Date(t0).toISOString()};
      try {
        var isReq = typeof Request !== 'undefined' && input instanceof Request;
        rec.url = abs(isReq ? input.url : input);
        rec.method = String((init && init.method) || (isReq ? input.method : 'GET')).toUpperCase();
        rec.reqHeaders = hdrs((init && init.headers) || (isReq ? input.headers : null));
        if (init && init.body != null) {
          rec.reqBody = cap(ser(init.body));
        } else if (isReq && rec.method !== 'GET' && rec.method !== 'HEAD') {
          // Must clone before the real fetch consumes the body.
          input.clone().text().then(function (t) { rec.reqBody = cap(t); }, function () {});
        }
      } catch (e) { rec.error = 'recorder: ' + e; }

      var p = origFetch.apply(this, arguments);
      p.then(function (res) {
        rec.status = res.status;
        rec.statusText = res.statusText;
        rec.finalUrl = res.url;
        rec.resHeaders = hdrs(res.headers);
        rec.mimeType = res.headers.get('content-type') || '';
        return res.clone().text().then(
          function (t) { rec.resBody = cap(t); },
          function (e) { rec.error = 'body: ' + e; });
      }, function (e) { rec.error = String(e); })
      .then(function () { rec.ms = Date.now() - t0; push(rec); });
      return p;
    };
  }

  // --- XMLHttpRequest (jQuery.ajax, Knockout, most of Ellucian) ------------
  var XP = XMLHttpRequest.prototype;
  var origOpen = XP.open, origSetHeader = XP.setRequestHeader, origSend = XP.send;
  XP.open = function (method, url) {
    this.__mycuRec = {kind: 'xhr', method: String(method).toUpperCase(), url: abs(url), reqHeaders: []};
    return origOpen.apply(this, arguments);
  };
  XP.setRequestHeader = function (name, value) {
    if (this.__mycuRec) { this.__mycuRec.reqHeaders.push({name: String(name), value: String(value)}); }
    return origSetHeader.apply(this, arguments);
  };
  XP.send = function (body) {
    var xhr = this, rec = xhr.__mycuRec;
    if (rec) {
      var t0 = Date.now();
      rec.started = new Date(t0).toISOString();
      rec.reqBody = cap(ser(body));
      xhr.addEventListener('loadend', function () {
        try {
          rec.status = xhr.status;
          rec.statusText = xhr.statusText;
          rec.finalUrl = xhr.responseURL;
          rec.resHeaders = rawHdrs(xhr.getAllResponseHeaders());
          rec.mimeType = xhr.getResponseHeader('content-type') || '';
          var rt = xhr.responseType;
          if (rt === '' || rt === 'text') { rec.resBody = cap(xhr.responseText); }
          else if (rt === 'json') { rec.resBody = cap(JSON.stringify(xhr.response)); }
          else if (rt === 'document' && xhr.response) { rec.resBody = cap(xhr.response.documentElement.outerHTML); }
          else { rec.resBody = ser(xhr.response); }
        } catch (e) { rec.error = 'recorder: ' + e; }
        rec.ms = Date.now() - t0;
        push(rec);
      });
    }
    return origSend.apply(this, arguments);
  };

  // --- sendBeacon (fire and forget; no response to record) ----------------
  if (navigator.sendBeacon) {
    var origBeacon = navigator.sendBeacon;
    navigator.sendBeacon = function (url, data) {
      push({kind: 'beacon', method: 'POST', url: abs(url), reqHeaders: [],
            reqBody: cap(ser(data)), started: new Date().toISOString()});
      return origBeacon.apply(this, arguments);
    };
  }

  // --- Form submission: the request itself becomes a navigation, so only the
  // outgoing half can be seen from here. The response is the next page.
  window.addEventListener('submit', function (ev) {
    try {
      var form = ev.target;
      var method = String(form.method || 'GET').toUpperCase();
      var body = ser(new FormData(form));
      push({kind: 'form', method: method, url: abs(form.action || location.href),
            reqHeaders: [{name: 'Content-Type', value: form.enctype || 'application/x-www-form-urlencoded'}],
            reqBody: method === 'GET' ? null : cap(body), started: new Date().toISOString()});
    } catch (e) {}
  }, true);
})();
"""

#: Swap the queue out and hand it over. The swap is one JS turn, so nothing a
#: request pushes can land between the read and the reset.
DRAIN_JS = """
(function () {
  var items = window.__mycuNet || [];
  window.__mycuNet = [];
  return JSON.stringify({href: String(location.href),
                         installed: !!window.__mycuNetInstalled,
                         items: items});
})()
"""

DRAIN_INTERVAL_MS = 750
DRAIN_TOKEN = "mycu-discover-drain"

#: Header and form-field names whose values are credentials. These are masked
#: in the report even with --show-values: a session cookie is not "a value you
#: might be comfortable sharing", it is your login.
SENSITIVE = re.compile(
    r"cookie|authorization|token|csrf|xsrf|session|saml|secret|password"
    # Microsoft's sign-in sends its anti-forgery value as `canary`, and its
    # telemetry an `apikey`; neither says so in a way the words above catch.
    r"|canary|api-?key",
    re.I,
)


def install_recorder(backend) -> bool:
    """Add :data:`NET_RECORDER_JS` to the default profile, for every page and frame.

    Profile-wide rather than per-view so the surface QML stays untouched; the
    desktop and Android surfaces must keep an identical interface.
    """
    profile_of = getattr(backend, "_default_profile", None)
    if profile_of is None:
        return False

    from PySide6.QtWebEngineCore import QWebEngineScript

    script = QWebEngineScript()
    script.setName("mycu-net-recorder")
    script.setSourceCode(NET_RECORDER_JS)
    script.setInjectionPoint(QWebEngineScript.InjectionPoint.DocumentCreation)
    script.setWorldId(QWebEngineScript.ScriptWorldId.MainWorld)
    script.setRunsOnSubFrames(True)
    profile_of().scripts().insert(script)
    return True


class NetLog:
    """Everything the recorder has seen, drained off the page as it goes.

    Runs entirely on the GUI thread: ``evalAsync`` is non-blocking and its
    answer arrives on the surface's ``evalResult`` signal, which the transport
    also listens to and ignores for tokens it does not own.
    """

    def __init__(self, surface) -> None:
        self.surface = surface
        self.records: list[dict] = []
        self.navigations: list[dict] = []
        #: Whether the recorder was present on the page at the latest drain.
        self.last_installed: bool | None = None
        self.stopped = False
        self._last_url = ""
        surface.evalResult.connect(self._on_result)

    def tick(self) -> None:
        if self.stopped:
            return
        url = str(self.surface.property("currentUrl") or "")
        if url and url != self._last_url:
            self._last_url = url
            self.navigations.append({"url": url, "at": _now_iso()})
        if url.startswith("http"):
            self.surface.evalAsync(DRAIN_TOKEN, DRAIN_JS)

    def ingest(self, raw: object) -> None:
        """Take one drain result. Also used for the final, blocking drain."""
        try:
            payload = json.loads(str(raw))
        except (json.JSONDecodeError, TypeError):
            return
        if not isinstance(payload, dict):
            return
        self.last_installed = bool(payload.get("installed"))
        self.records.extend(r for r in payload.get("items") or [] if isinstance(r, dict))

    def _on_result(self, token: str, result: object) -> None:
        # Still ingested after stop(): a drain already in flight has swapped the
        # page's queue out, so dropping its answer would lose those records.
        if token == DRAIN_TOKEN:
            self.ingest(result)


def _now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


# ---------------------------------------------------------------------------
# HAR in and out
# ---------------------------------------------------------------------------

def records_to_har(records: list[dict], navigations: list[dict]) -> dict:
    """Recorder output as HAR 1.2, so DevTools can open it (Network → Import)."""
    entries = []
    for rec in records:
        url = str(rec.get("url", ""))
        req_headers = list(rec.get("reqHeaders") or [])
        res_headers = list(rec.get("resHeaders") or [])
        req_body = rec.get("reqBody")
        res_body = rec.get("resBody") or ""
        ms = float(rec.get("ms") or 0)

        request = {
            "method": rec.get("method", "GET"),
            "url": url,
            "httpVersion": "HTTP/1.1",
            "cookies": [],
            "headers": req_headers,
            "queryString": [{"name": k, "value": v}
                            for k, v in parse_qsl(urlsplit(url).query, keep_blank_values=True)],
            "headersSize": -1,
            "bodySize": len(req_body) if req_body is not None else 0,
        }
        if req_body is not None:
            request["postData"] = {"mimeType": _header(req_headers, "content-type"),
                                   "text": req_body}

        entries.append({
            "startedDateTime": rec.get("started") or _now_iso(),
            "time": ms,
            "request": request,
            "response": {
                "status": int(rec.get("status") or 0),
                "statusText": rec.get("statusText", ""),
                "httpVersion": "HTTP/1.1",
                "cookies": [],
                "headers": res_headers,
                "content": {"size": len(res_body), "mimeType": rec.get("mimeType", ""),
                            "text": res_body},
                "redirectURL": "",
                "headersSize": -1,
                "bodySize": len(res_body),
            },
            "cache": {},
            "timings": {"send": 0, "wait": ms, "receive": 0},
            "_resourceType": rec.get("kind", ""),
            "_page": rec.get("page", ""),
            "_frame": rec.get("frame", ""),
            "_finalUrl": rec.get("finalUrl", ""),
            "_error": rec.get("error", ""),
        })

    return {"log": {
        "version": "1.2",
        "creator": {"name": "CedarView scripts/discover", "version": "1"},
        "pages": [],
        "entries": entries,
        "_navigations": navigations,
    }}


def har_to_records(har: dict) -> tuple[list[dict], list[dict]]:
    """Read any HAR — ours, or a DevTools/Firefox export — back into records."""
    log = har.get("log") or {}
    records = []
    for entry in log.get("entries") or []:
        req = entry.get("request") or {}
        res = entry.get("response") or {}
        content = res.get("content") or {}
        text = content.get("text")
        if text and content.get("encoding") == "base64":
            try:
                text = base64.b64decode(text).decode("utf-8")
            except (ValueError, UnicodeDecodeError):
                text = f"<binary {content.get('size', '?')} bytes>"
        records.append({
            "kind": entry.get("_resourceType") or "",
            "method": req.get("method", "GET"),
            "url": req.get("url", ""),
            "reqHeaders": req.get("headers") or [],
            "reqBody": (req.get("postData") or {}).get("text"),
            "status": res.get("status", 0),
            "resHeaders": res.get("headers") or [],
            "mimeType": content.get("mimeType") or _header(res.get("headers") or [], "content-type"),
            "resBody": text or "",
            "page": entry.get("_page", ""),
            "error": entry.get("_error", ""),
            "started": entry.get("startedDateTime", ""),
        })
    return records, list(log.get("_navigations") or [])


def _header(headers: list[dict], name: str) -> str:
    for h in headers:
        if str(h.get("name", "")).lower() == name:
            return str(h.get("value", ""))
    return ""


# ---------------------------------------------------------------------------
# Traffic report
# ---------------------------------------------------------------------------

def describe_traffic(records: list[dict], navigations: list[dict], *, show_values: bool,
                     all_hosts: bool, keywords: list[str]) -> list[str]:
    """The RECORDED TRAFFIC section: one block per request, credentials masked."""
    out = ["", "-" * 72, "RECORDED TRAFFIC — what the page actually sent and got back", "-" * 72]

    if navigations:
        out.append("\n  navigations (in order):")
        for nav in navigations:
            out.append(f"    {nav.get('at', '')}  {nav.get('url', '')}")

    shown = [r for r in records if all_hosts or not BORING.search(str(r.get("url", "")))]
    hidden = len(records) - len(shown)
    out.append(f"\n  {len(records)} request(s) recorded, {len(shown)} shown"
               + (f" ({hidden} analytics/static hidden; --all-hosts to include)" if hidden else ""))

    for n, rec in enumerate(shown, 1):
        url = str(rec.get("url", ""))
        body = str(rec.get("resBody") or "")
        mime = str(rec.get("mimeType") or "")
        status = rec.get("status", "")
        status_text = "—" if status in ("", None, 0) and rec.get("kind") in ("beacon", "form") else status

        hits = [k for k in keywords if k.lower() in body.lower()]
        flag = f"   <<< mentions {', '.join(hits)}" if hits else ""
        out.append("")
        out.append(f"  #{n} [{rec.get('kind', '?')}] {rec.get('method', '?')} {status_text}  {url}{flag}")
        out.append(f"     {mime or '(no content-type)'}  {len(body):,} bytes"
                   + (f"  from page {rec['page']}" if rec.get("page") else ""))
        if rec.get("finalUrl") and rec["finalUrl"] != url:
            out.append(f"     final URL: {rec['finalUrl']}")
        if rec.get("error"):
            out.append(f"     error: {rec['error']}")

        req_headers = rec.get("reqHeaders") or []
        if req_headers:
            out.append("     request headers:")
            for h in req_headers:
                out.append(f"       {h.get('name')}: {_header_value(h)}")

        req_body = rec.get("reqBody")
        if req_body:
            out.append("     request body:")
            out.extend("       " + line for line in
                       _describe_request_body(str(req_body), req_headers, show_values))

        if body:
            out.append("     response:")
            out.extend("       " + line for line in
                       _describe_response_body(body, mime, show_values).splitlines())

    return out


def _header_value(header: dict) -> str:
    name, value = str(header.get("name", "")), str(header.get("value", ""))
    if SENSITIVE.search(name):
        return f"<masked, {len(value)} chars>"
    # Content-Type, Accept, X-Requested-With and friends are structure, not
    # personal data, and they are exactly what a rebuilt client must send.
    return value


def _describe_request_body(body: str, headers: list[dict], show_values: bool) -> list[str]:
    stripped = body.lstrip()
    if stripped[:1] in "{[":
        try:
            return describe_json(json.loads(stripped), show_values).splitlines()
        except json.JSONDecodeError:
            pass
    ctype = _header(headers, "content-type").lower()
    if "=" in body and ("form" in ctype or not ctype):
        lines = ["form fields:"]
        for key, value in parse_qsl(body, keep_blank_values=True):
            if SENSITIVE.search(key):
                shown = f"<masked, {len(value)} chars>"
            else:
                shown = repr(value) if show_values else (_mask(value) or "''")
            lines.append(f"  {key} = {shown}")
        return lines
    return [f"<{len(body)} chars, content-type {ctype or 'unknown'}>"
            if not show_values else body[:2000]]


def _describe_response_body(body: str, mime: str, show_values: bool) -> str:
    stripped = body.lstrip()
    if stripped[:1] in "{[" or "json" in mime.lower():
        try:
            return "JSON SHAPE:\n" + describe_json(json.loads(stripped), show_values)
        except json.JSONDecodeError:
            pass
    if "html" in mime.lower() or stripped[:1] == "<":
        return "HTML STRUCTURE:\n" + describe_html(body, show_values)
    if show_values:
        return body[:2000]
    return f"<{len(body)} chars of {mime or 'text'}>"


# ---------------------------------------------------------------------------

def summarise_har(args: argparse.Namespace, spec: dict) -> int:
    """``--from-har``: the RECORDED TRAFFIC report for a HAR made anywhere."""
    try:
        har = json.loads(args.from_har.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"could not read {args.from_har}: {exc}")
        return 1

    records, navigations = har_to_records(har)
    lines = [
        "=" * 72,
        f"TARGET: {args.target}   (from {args.from_har.name})",
        f"values: {'SHOWN' if args.show_values else 'REDACTED (use --show-values to include)'}",
        "=" * 72,
    ]
    lines += describe_traffic(records, navigations, show_values=args.show_values,
                              all_hosts=args.all_hosts, keywords=spec.get("keywords", []))
    print("\n".join(lines))

    CAPTURES.mkdir(parents=True, exist_ok=True)
    summary = CAPTURES / f"{args.target}-report-{time.strftime('%Y%m%d-%H%M%S')}.txt"
    summary.write_text("\n".join(lines), encoding="utf-8")
    print(f"\nreport saved to {summary.relative_to(ROOT)}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("target", choices=sorted(TARGETS))
    parser.add_argument("--show-values", action="store_true",
                        help="print real values, not just shapes (they end up in the report)")
    parser.add_argument("--extra", action="append", default=[],
                        help="an extra URL to probe after login; repeatable")
    parser.add_argument("--timeout", type=float, default=900.0,
                        help="seconds to wait for you to press Capture")
    parser.add_argument("--start", metavar="URL",
                        help="open this page instead of the target's usual start page")
    parser.add_argument("--from-har", metavar="PATH", type=Path,
                        help="no window: summarise an existing HAR (ours, or a "
                             "Chrome/Firefox 'Save all as HAR') and exit")
    parser.add_argument("--devtools", metavar="PORT", type=int,
                        help="expose Chromium remote debugging on 127.0.0.1:PORT, "
                             "for the full DevTools Network panel on this window")
    parser.add_argument("--all-hosts", action="store_true",
                        help="do not hide analytics and static assets in RECORDED TRAFFIC")
    args = parser.parse_args()

    spec = TARGETS[args.target]

    if args.from_har:
        return summarise_har(args, spec)

    if args.devtools:
        # Read by Chromium at startup, so it has to be set before before_app().
        os.environ["QTWEBENGINE_REMOTE_DEBUGGING"] = f"127.0.0.1:{args.devtools}"

    import devkit

    backend = devkit.DesktopWeb()
    backend.before_app()

    from PySide6.QtCore import QObject, QTimer
    from PySide6.QtGui import QGuiApplication
    from PySide6.QtQml import QQmlApplicationEngine

    from devkit import MycuError, WebViewTransport, run_in_background

    app = QGuiApplication(sys.argv[:1])
    app.setApplicationName("CedarView discover")

    devkit.state_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    backend.configure_profile(devkit.profile_dir())

    # Before the first navigation, or the page that matters loads unrecorded.
    if not install_recorder(backend):
        print(f"warning: no network recorder on the {backend.name} backend; "
              "RECORDED TRAFFIC will be empty")

    toolbar = f"""
    signal captureRequested()
    property bool capturing: false

    header: ToolBar {{
        RowLayout {{
            anchors.fill: parent
            anchors.margins: 8
            Label {{
                Layout.fillWidth: true
                wrapMode: Text.Wrap
                text: win.capturing
                      ? "Capturing… leave this window open."
                      : {json.dumps(spec["note"])}
            }}
            Button {{
                text: win.capturing ? "Working…" : "Capture"
                enabled: !win.capturing
                highlighted: true
                onClicked: {{ win.capturing = true; win.captureRequested() }}
            }}
        }}
    }}
"""
    engine = QQmlApplicationEngine()
    engine.loadData(devkit.surface_window_qml(
        backend.surface_qml, title=f"CedarView discover — {args.target}",
        width=1100, height=900, header=toolbar,
    ).encode())
    if not engine.rootObjects():
        print("the web surface failed to load — are you inside `nix develop`?")
        return 1

    # `window` must stay in a Python variable for the whole run. Chaining
    # `engine.rootObjects()[0].findChild(...)` drops the last Python reference
    # to the root object and shiboken deletes the C++ object underneath it; the
    # surface then comes back as a dead wrapper.
    window = engine.rootObjects()[0]
    surface = window.findChild(QObject, "surface")
    if surface is None:
        print("could not find the web surface in the loaded QML")
        return 1

    transport = WebViewTransport()
    transport.attach_surface(surface)

    net = NetLog(surface)
    drainer = QTimer()
    drainer.timeout.connect(net.tick)
    drainer.start(DRAIN_INTERVAL_MS)

    report: list[str] = []
    started = time.monotonic()
    stamp = time.strftime("%Y%m%d-%H%M%S")

    def out(line: str = "") -> None:
        print(line)
        report.append(line)

    def capture() -> None:
        out("=" * 72)
        out(f"TARGET: {args.target}")
        out(f"values: {'SHOWN' if args.show_values else 'REDACTED (use --show-values to include)'}")
        out("=" * 72)

        current = transport.current_url
        out(f"\ncurrent page: {current}")
        CAPTURES.mkdir(parents=True, exist_ok=True)

        # --- 0. Recorded traffic ----------------------------------------------
        # Drained BEFORE anything below runs: the probes further down go through
        # the page's fetch(), which the recorder wraps, and the tool's own
        # requests must not end up in the log of what the page did.
        try:
            net.ingest(transport.evaluate(DRAIN_JS))
        except Exception as exc:  # noqa: BLE001
            out(f"  (final drain failed: {exc})")

        installed = net.last_installed
        out(f"recorder installed on this page: "
            f"{'yes' if installed else 'NO — use --devtools' if installed is False else 'unknown'}")

        har_path = CAPTURES / f"{args.target}-network-{stamp}.har"
        har_path.write_text(json.dumps(records_to_har(net.records, net.navigations), indent=1),
                            encoding="utf-8")
        har_path.chmod(0o600)
        out(f"network log   {har_path.relative_to(ROOT)}   "
            "(gitignored; LIVE COOKIES AND TOKENS — never commit or paste)")

        try:
            dom = transport.evaluate("document.documentElement.outerHTML", timeout_s=30)
            dom_path = CAPTURES / f"{args.target}-dom-{stamp}.html"
            dom_path.write_text(str(dom or ""), encoding="utf-8")
            out(f"rendered DOM  {dom_path.relative_to(ROOT)}   (gitignored, full values)")
        except Exception as exc:  # noqa: BLE001
            out(f"rendered DOM  unavailable: {exc}")

        for line in describe_traffic(net.records, net.navigations,
                                     show_values=args.show_values, all_hosts=args.all_hosts,
                                     keywords=spec.get("keywords", [])):
            out(line)

        # Anything the recorder already has in full is not re-fetched: a bare
        # GET replay of a POST or token-guarded endpoint only produces noise.
        recorded = {str(r.get(k)) for r in net.records for k in ("url", "finalUrl") if r.get(k)}

        # --- 1. What did this page fetch? --------------------------------
        out("\n" + "-" * 72)
        out("NETWORK TRACE — every URL this page requested")
        out("-" * 72)
        discovered: list[str] = []
        try:
            raw = transport.evaluate(
                "JSON.stringify(performance.getEntriesByType('resource')"
                ".map(function(e){return {n:e.name,t:e.initiatorType};}))"
            )
            entries = json.loads(str(raw)) if raw else []
        except Exception as exc:  # noqa: BLE001
            out(f"  (trace unavailable: {exc})")
            entries = []

        for entry in entries:
            url = entry.get("n", "")
            kind = entry.get("t", "")
            if BORING.search(url):
                continue
            flag = ""
            if kind in ("xmlhttprequest", "fetch") or INTERESTING.search(url):
                flag = "  <<< DATA ENDPOINT"
                if url not in discovered:
                    discovered.append(url)
            out(f"  [{kind}] {url}{flag}")

        if not entries:
            out("  (none — the page may have been served without client-side fetches)")

        # --- 2. Probe -----------------------------------------------------
        # The current page ALWAYS goes first. It got skipped whenever the trace
        # found anything at all, which is exactly backwards: a server-rendered
        # page has the data in its own HTML and often traces nothing but a chart
        # image. That gap lost the Meals page entirely on the first run.
        replayable = [u for u in discovered if u not in recorded]
        if len(replayable) < len(discovered):
            out(f"\n  ({len(discovered) - len(replayable)} traced URL(s) not re-probed: "
                "already in RECORDED TRAFFIC with their real method and body)")
        probes = [current] + list(spec["probes"]) + list(args.extra) + replayable

        seen: set[str] = set()
        for url in probes:
            if not url or url in seen:
                continue
            seen.add(url)

            out("\n" + "-" * 72)
            out(f"PROBE  {url}")
            out("-" * 72)
            try:
                response = transport.get(url, timeout_s=45)
            except MycuError as exc:
                out(f"  FAILED: {type(exc).__name__}: {exc}")
                continue

            ctype = response.headers.get("content-type", "")
            out(f"  final URL     {response.url}")
            out(f"  status        {response.status}")
            out(f"  content-type  {ctype or '(none)'}")
            out(f"  size          {len(response.body):,} bytes")

            CAPTURES.mkdir(parents=True, exist_ok=True)
            stem = re.sub(r"[^A-Za-z0-9]+", "_", url)[:80].strip("_")
            probe_stamp = time.strftime("%Y%m%d-%H%M%S")
            stripped = response.body.lstrip()
            is_json = stripped[:1] in "{[" or "json" in ctype.lower()
            path = CAPTURES / f"{args.target}-{stem}-{probe_stamp}.{'json' if is_json else 'html'}"
            path.write_text(response.body, encoding="utf-8")
            out(f"  raw body      {path.relative_to(ROOT)}   (gitignored, full values)")

            out("")
            if is_json:
                try:
                    out("  JSON SHAPE:")
                    out("    " + describe_json(
                        json.loads(stripped), args.show_values
                    ).replace("\n", "\n    "))
                except json.JSONDecodeError as exc:
                    out(f"  (claimed JSON but did not parse: {exc})")
            else:
                out("  HTML STRUCTURE:")
                out("    " + describe_html(response.body, args.show_values).replace("\n", "\n    "))

        out("\n" + "=" * 72)
        out("done — close the window")

    def on_capture() -> None:
        # No more drains from the timer; capture() does the last one itself.
        net.stopped = True
        drainer.stop()

        def finish(_: object) -> None:
            summary = CAPTURES / f"{args.target}-report-{stamp}.txt"
            CAPTURES.mkdir(parents=True, exist_ok=True)
            summary.write_text("\n".join(report), encoding="utf-8")
            print(f"\nreport saved to {summary.relative_to(ROOT)}")
            print("share the report; keep the .har and -dom files local")
            app.quit()

        def failed(exc: object) -> None:
            print(f"\ncapture failed: {type(exc).__name__}: {exc}")
            app.quit()

        run_in_background(capture, finish, failed)

    window.captureRequested.connect(on_capture)

    def deadline() -> None:
        if time.monotonic() - started > args.timeout:
            print(f"timed out after {args.timeout:.0f}s without a capture")
            app.quit()

    ticker = QTimer()
    ticker.timeout.connect(deadline)
    ticker.start(5000)

    start = args.start or spec["start"]
    print(f"opening {start}")
    print(spec["note"])
    if args.devtools:
        print(f"\nDevTools: open http://127.0.0.1:{args.devtools} in Chromium (or "
              "chrome://inspect) → pick the page → Network. Tick 'Preserve log'.")
    print("\nSign in if needed, get to the page you care about, then press Capture.\n")
    surface.navigate(start)

    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())
