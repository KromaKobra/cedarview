#!/usr/bin/env bash
# Android build driver.
#
#   nix develop                  # then:
#   mycu-android-build           # the FHS env — REQUIRED
#   ./scripts/build-apk          # this script
#
# or in one shot:
#
#   nix develop --command mycu-android-build -c ./scripts/build-apk
#
# Flags:
#   --install    adb install -r the APK onto the connected device afterwards
#   --clean      discard the staging tree and the buildozer state first
#
# ---------------------------------------------------------------------------
# Why this builds from a COPY of the project (android-build/)
# ---------------------------------------------------------------------------
#
# NOTE ON THE NAME: it is `android-build/`, not `.android-build/`, and that
# matters. buildozer's _copy_application_sources() filters hidden directories
# with
#
#     if True in [x.startswith('.') for x in root.split(sep)]: continue
#
# which tests the **absolute** path, not the path relative to source.dir. A
# staging directory called `.android-build` therefore makes every single file
# look hidden, buildozer copies nothing at all, and the build dies much later
# and very confusingly with:
#
#     BUILD FAILURE: No main.py(c) found in your app directory.
#
# Do not rename this to a dotted directory, and do not put the project under
# one either.
#
# pyside6-android-deploy decides which Qt modules to bundle by scanning every
# .py and .qml file under the project directory. Two files in this repo are
# desktop-only and name QtWebEngine:
#
#     mycu/platform/desktop.py          from PySide6.QtWebEngineQuick import …
#     mycu/ui/qml/WebSurfaceDesktop.qml import QtWebEngine
#
# QtWebEngine does not exist on Android, so if the scanner sees either of them
# the build dies with:
#
#     FileNotFoundError: libQt6WebEngineCore_arm64-v8a.so not found inside the wheel
#
# Pinning `modules` in pysidedeploy.spec does NOT help, and it is worth
# recording why, because it looks like it should. Two bugs in the 6.11 tool:
#
#   1. deploy_lib/config.py, end of Config.__init__, runs `self.modules = []`.
#      That is the property SETTER, which writes an empty `modules` back into
#      the parsed config — before AndroidConfig reads it. A pinned value is
#      therefore always discarded and the scan always runs.
#
#   2. deploy_lib/android/android_config.py reads ndk_path under
#      `elif not existing_config_file:` — inverted, so supplying a spec that
#      already contains ndk_path makes it read None and crash with
#      `TypeError: unsupported operand type(s) for /: 'NoneType' and 'str'`.
#
# Both are sidestepped by building in a staging tree that simply does not
# contain the desktop files, and letting the tool generate its own spec there
# from scratch. Nothing in your working tree is moved or modified, which also
# means an interrupted build cannot leave the repo in a half-state.
#
# Desktop behaviour is unaffected: mycu.platform.current_backend() imports the
# desktop backend by name and only when not on Android, so the copy that goes
# into the APK never needs those two files.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

VENV="$ROOT/.venv-android"
WHEELS="$ROOT/.android-wheels"
STAGE="$ROOT/android-build"

PYSIDE_VERSION="6.11.0"          # must match the desktop Qt in flake.nix
ARCH="aarch64"                   # the phone is arm64-v8a

# The launcher icon, pinned in phase 1a. Absolute on purpose: buildozer
# resolves icon.filename relative to its own root ($STAGE), not the project
# root, so a relative path silently resolves to the wrong place.
#
# Note this is NOT the header logo in the app — that is mycu/ui/qml/icon.png,
# loaded by Main.qml. They are separate files with separate delivery paths: the
# logo rides in private.tar and can be pushed onto a device, the launcher icon
# is a compiled Android resource and cannot. Changing one does not change the
# other; keep them visually related by hand.
#
# p4a copies this file verbatim into res/mipmap/icon.png — no resize, no format
# conversion, no density variants — so it wants to be a large square PNG with
# alpha. See docs/iterating-and-shipping.md §2.
ICON="$ROOT/assets/appicon.png"

# The adaptive (Oreo and later) pair. ICON above stays as the legacy fallback
# for API < 26, and is what p4a copies to res/mipmap/icon.png.
#
# Both must be set or p4a prints "Received an --icon_fg or an --icon_bg
# argument, but not both. Ignoring." and silently falls back to the legacy
# path, which is the thing these exist to escape.
#
# Regenerate with scripts/make-icon-layers.
ICON_FG="$ROOT/assets/appicon_foreground.png"
ICON_BG="$ROOT/assets/appicon_background.png"
QT_DL="https://download.qt.io/official_releases/QtForPython"
WHEEL_PYSIDE="$WHEELS/pyside6-${PYSIDE_VERSION}-${PYSIDE_VERSION}-cp311-cp311-android_${ARCH}.whl"
WHEEL_SHIBOKEN="$WHEELS/shiboken6-${PYSIDE_VERSION}-${PYSIDE_VERSION}-cp311-cp311-android_${ARCH}.whl"

DO_INSTALL=0
DO_CLEAN=0
DO_RELEASE=0
for arg in "$@"; do
  case "$arg" in
    --install) DO_INSTALL=1 ;;
    --clean)   DO_CLEAN=1 ;;
    --release) DO_RELEASE=1 ;;
    *) printf 'unknown flag: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }
die()  { printf '\033[31merror:\033[0m %s\n' "$1" >&2; exit 1; }

# --- Preconditions ----------------------------------------------------------

step "Checking preconditions"

[[ -n "${BUILDOZER_HOME:-}" ]] || die \
  "not inside the Android FHS shell. Run 'nix develop --command mycu-android-build'
   first (or 'nix run .#android-shell'). buildozer and python-for-android need
   an FHS layout; the plain devShell cannot provide one. See docs/android.md."

command -v java >/dev/null || die "no JDK on PATH (expected inside the FHS env)"

# python-for-android's CPython build, and the only Android wheels Qt publishes,
# are both 3.11; pyside6-android-deploy refuses to run on anything newer.
PYVER="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
[[ "$PYVER" == "3.11" ]] || die \
  "python3 in the FHS env is $PYVER, need 3.11. pyside6-android-deploy refuses
   to start on newer ('Android deployment requires Python version 3.11 or
   lower'), and Qt only ships cp311 Android wheels. Fix the androidFhs
   targetPkgs in flake.nix."

[[ -f "$ICON" ]] || die \
  "launcher icon not found at $ICON. Phase 1a pins it into buildozer.spec and
   the build would otherwise ship PySide's stock icon without saying so."

# The launcher label — the name under the icon on the home screen.
#
# Pinned here rather than passed as `--name` to the deploy tool, and that is
# not a style choice. deploy_lib/android/buildozer.py:18-19 writes the SAME
# value to two keys:
#
#     self.set_value("app", "title",        pysidedeploy_config.title)
#     self.set_value("app", "package.name", pysidedeploy_config.title)
#
# so `--name CedarView` would also change package.name, and with it the
# applicationId (org.mycu.CedarView) and the p4a dist name. A new
# applicationId is a *different app* to Android: it installs alongside the old
# one instead of over it, with a fresh empty data directory. Pinning `title`
# alone renames what the user sees and leaves the app's identity alone.
#
# See §3.7 in docs/iterating-and-shipping.md for changing the identity too,
# which is a thing to decide before the first public release, not after.
APP_TITLE="CedarView"

# The app version, read from the source rather than left at buildozer's default.
#
# buildozer's own default.spec says `version = 0.1` and nothing connects it to
# this project, so every build — including every release — carried versionCode
# 10211. Android derives the upgrade ordering from that number, so two releases
# that share it are not an upgrade pair. Phase 1a pins it from __version__.
APP_VERSION="$(python3 -c "
import re, pathlib
src = pathlib.Path('$ROOT/mycu/__init__.py').read_text()
print(re.search(r'__version__\s*=\s*[\"\']([^\"\']+)', src).group(1))
")"
[[ -n "$APP_VERSION" ]] || die "could not read __version__ from mycu/__init__.py"

if (( DO_RELEASE )); then
  # p4a signs the APK itself, from these four. buildozer checks all four and
  # silently drops --sign if any is missing, which yields an UNSIGNED release
  # APK that no phone will install — so check here, where it can be explained.
  for v in P4A_RELEASE_KEYSTORE P4A_RELEASE_KEYSTORE_PASSWD \
           P4A_RELEASE_KEYALIAS P4A_RELEASE_KEYALIAS_PASSWD; do
    [[ -n "${!v:-}" ]] || die \
      "--release needs \$$v set.
   All four of P4A_RELEASE_{KEYSTORE,KEYSTORE_PASSWD,KEYALIAS,KEYALIAS_PASSWD}
   are required; buildozer drops --sign without saying so if any is missing.
   See docs/iterating-and-shipping.md §3.3 for generating the keystore."
  done
  [[ -f "${P4A_RELEASE_KEYSTORE}" ]] || die \
    "keystore not found: $P4A_RELEASE_KEYSTORE"
fi

for f in "$ICON_FG" "$ICON_BG"; do
  [[ -f "$f" ]] || die \
    "adaptive icon layer missing: $f
   Both layers are required — p4a ignores a lone one and falls back to the
   legacy icon. Regenerate with:
       QT_QPA_PLATFORM=offscreen python scripts/make-icon-layers assets"
done

if command -v adb >/dev/null; then
  if ! adb devices | tail -n +2 | grep -q '\sdevice$'; then
    printf '\033[33mwarning:\033[0m no authorised device visible to adb.\n'
    printf '         The APK will still build. If the phone shows as\n'
    printf '         "unauthorized", unlock it and accept the RSA prompt.\n'
    DO_INSTALL=0
  fi
else
  printf '\033[33mwarning:\033[0m adb not on PATH; --install unavailable.\n'
  DO_INSTALL=0
fi

echo "ok"

if (( DO_CLEAN )); then
  step "Cleaning"
  rm -rf "$STAGE" "$ROOT/.buildozer" "$ROOT/deployment"
fi

# --- Toolchain --------------------------------------------------------------

if [[ ! -x "$VENV/bin/pyside6-android-deploy" ]]; then
  step "Creating the Android build venv (downloads ~700 MB)"
  rm -rf "$VENV"
  python3 -m venv "$VENV"
  # shellcheck disable=SC1091
  source "$VENV/bin/activate"
  pip install --upgrade pip
  pip install "pyside6==${PYSIDE_VERSION}" --no-cache-dir
  # The deploy tool's own extras (jinja2, pkginfo, tqdm, packaging==24.1). They
  # are not dependencies of the pyside6 wheel, and without them the tool exits
  # with a bare "The following packages are required but not installed".
  pip install -r "$VENV/lib/python3.11/site-packages/PySide6/scripts/requirements-android.txt"
else
  # shellcheck disable=SC1091
  source "$VENV/bin/activate"
fi

command -v pyside6-android-deploy >/dev/null || die \
  "pyside6-android-deploy is still not on PATH after installing the wheel."

# --- Android wheels ---------------------------------------------------------
#
# These are the Qt-for-Android builds of PySide6/shiboken6. They are NOT on
# PyPI — only on download.qt.io — and they are what actually ends up in the
# APK. The x86_64 variants exist too, for an emulator.

if [[ ! -f "$WHEEL_PYSIDE" || ! -f "$WHEEL_SHIBOKEN" ]]; then
  step "Downloading the PySide6 Android wheels (~80 MB)"
  mkdir -p "$WHEELS"
  [[ -f "$WHEEL_PYSIDE"   ]] || curl -fL --retry 3 -o "$WHEEL_PYSIDE" \
    "$QT_DL/pyside6/$(basename "$WHEEL_PYSIDE")"
  [[ -f "$WHEEL_SHIBOKEN" ]] || curl -fL --retry 3 -o "$WHEEL_SHIBOKEN" \
    "$QT_DL/shiboken6/$(basename "$WHEEL_SHIBOKEN")"
fi

# Cheap guard against a truncated or HTML-error download, which otherwise
# surfaces much later as an incomprehensible zipfile error.
python3 - "$WHEEL_PYSIDE" "$WHEEL_SHIBOKEN" <<'PY'
import sys, zipfile
for path in sys.argv[1:]:
    if not zipfile.is_zipfile(path):
        sys.exit(f"error: {path} is not a valid wheel — delete it and re-run")
    if "PySide6/QtWebView.abi3.so" in zipfile.ZipFile(path).namelist():
        print("QtWebView present in the PySide6 Android wheel")
PY

# --- Staging tree -----------------------------------------------------------

step "Staging the project without the desktop-only files"

# Only the sources we manage are replaced. $STAGE/.buildozer holds the
# python-for-android build tree — a cross-compiled CPython, libffi, OpenSSL and
# the Qt libs, tens of minutes of work — so wiping it on every run would make
# each build as slow as the first. `--clean` is the way to discard it.
mkdir -p "$STAGE"
rm -rf "$STAGE/mycu" "$STAGE/main.py" "$STAGE/pyproject.toml"

cp "$ROOT/main.py" "$ROOT/pyproject.toml" "$STAGE/"
cp -r "$ROOT/mycu" "$STAGE/mycu"

# The two files that would drag QtWebEngine into the module scan. See the long
# comment at the top of this script.
rm -f "$STAGE/mycu/platform/desktop.py"
rm -f "$STAGE/mycu/ui/qml/WebSurfaceDesktop.qml"
find "$STAGE" -name '__pycache__' -type d -prune -exec rm -rf {} +

# Fail loudly rather than produce an APK with no login, if either file is ever
# renamed and this script is not updated with it.
#
# Only real import statements matter: the Python scanner looks for PySide6
# imports and qmlimportscanner parses QML `import` lines. The word QtWebEngine
# appears all over this codebase's prose — every docstring explaining why
# Android uses QtWebView instead — and none of that affects the build, so the
# pattern is anchored to import syntax rather than matching the bare word.
WEBENGINE_IMPORT='^[[:space:]]*(import[[:space:]]+QtWebEngine|from[[:space:]]+PySide6\.QtWebEngine|import[[:space:]]+PySide6\.QtWebEngine)'
if grep -rEl --include='*.py' --include='*.qml' "$WEBENGINE_IMPORT" "$STAGE" >/dev/null 2>&1; then
  grep -rEn --include='*.py' --include='*.qml' "$WEBENGINE_IMPORT" "$STAGE" >&2
  die "QtWebEngine is still IMPORTED in the staging tree (above). The module
   scan will fail on libQt6WebEngineCore_${ARCH}.so. Update the prune list."
fi

# --- Android SDK licences ---------------------------------------------------
#
# buildozer downloads the SDK on first run and then stops dead on Google's
# licence prompt, because its stdin is not a terminal:
#
#     Accept? (y/N): Skipping following packages as the license is not accepted
#
# …and the build fails several minutes later with a bare non-zero exit from
# `buildozer android debug`, which does not mention licences at all.
#
# Note the SDK goes to ~/.buildozer, NOT to $BUILDOZER_HOME — buildozer 1.5.0
# ignores that variable for the global directory, despite what the comment in
# flake.nix used to claim. Acceptance is recorded in $SDK/licenses/ and
# persists, so this is a one-off on a given machine.

SDK_ROOT="${ANDROID_SDK_ROOT:-$HOME/.buildozer/android/platform/android-sdk}"
if [[ -x "$SDK_ROOT/tools/bin/sdkmanager" && ! -f "$SDK_ROOT/licenses/android-sdk-license" ]]; then
  step "Accepting the Android SDK licences"
  yes | "$SDK_ROOT/tools/bin/sdkmanager" --licenses --sdk_root="$SDK_ROOT" >/dev/null 2>&1 || true
  [[ -f "$SDK_ROOT/licenses/android-sdk-license" ]] \
    && echo "accepted; recorded in $SDK_ROOT/licenses/" \
    || printf '\033[33mwarning:\033[0m licence acceptance did not stick; the build may stop at the prompt.\n'
fi

# --- Build ------------------------------------------------------------------

step "Building (python-for-android compiles CPython for $ARCH; this is slow)"

cd "$STAGE"

# Phase 1 — generate the config, then stop.
#
# No pysidedeploy.spec exists here on purpose: letting the tool create its own
# is what keeps it on the code path where ndk_path and modules are handled
# correctly (see the header). `--init` returns straight after writing
# pysidedeploy.spec and buildozer.spec, and --keep-deployment-files stops the
# `finally:` block deleting the generated recipes and jars on the way out.
rm -f pysidedeploy.spec buildozer.spec
pyside6-android-deploy --init --keep-deployment-files \
  --name mycu \
  --wheel-pyside "$WHEEL_PYSIDE" \
  --wheel-shiboken "$WHEEL_SHIBOKEN"

[[ -f buildozer.spec ]] || die "--init did not produce a buildozer.spec"

# Phase 1a — pin the permissions.
#
# THIS IS WHY THE BUILD IS SPLIT IN TWO. pyside6-android-deploy sets
# android.permissions to the UNION of every permission any bundled Qt module
# declares in its dependency XML — not what the app uses. On this project that
# came out as:
#
#     ACCESS_NETWORK_STATE, WRITE_EXTERNAL_STORAGE, INTERNET, ACCESS_FINE_LOCATION
#
# An app that reads your own chapel attendance has no business asking for your
# location or for external storage. The app makes HTTPS requests and nothing
# else, so the manifest says INTERNET and nothing else.
#
# Re-pinned on every build because phase 1 rewrites buildozer.spec each time.
#
# The p4a pin is the second edit, and it is not optional either:
#
# pyside6-android-deploy writes `p4a.branch = develop`, and python-for-android
# moved its python3 recipe to **CPython 3.14** in commit e1bd249 (2025-10-28).
# Qt's Android wheels are built against **3.11** — and while nearly everything
# in them is named `*.abi3.so`, which suggests the stable ABI makes the version
# irrelevant, `libshiboken6.abi3.so` carries a hard DT_NEEDED on
# `libpython3.11.so`. The APK builds and installs perfectly happily, then dies
# on launch:
#
#     dlopen failed: library "libpython3.11.so" not found:
#       needed by .../lib/arm64/libshiboken6.abi3.so
#     java.lang.UnsatisfiedLinkError ... qtMainLoopThread
#
# Check it yourself rather than trusting the abi3 suffix:
#
#     python3 -c "import re,zipfile; print(sorted(set(re.findall(
#       rb'libpython[0-9.]*\.so',
#       zipfile.ZipFile('$WHEEL_SHIBOKEN').read('shiboken6/libshiboken6.abi3.so')))))"
#
# P4A_COMMIT is the commit immediately before the 3.14 bump, so the qt
# bootstrap stays current while CPython stays 3.11.13. Revisit when Qt ships
# Android wheels for a newer CPython.
P4A_COMMIT="3762c88c56e3443efb8eba2a02a2604b680240fd"   # 2025-10-26, python3 3.11.13

step "Pinning permissions, the p4a revision, and the launcher icon"
python3 - buildozer.spec "$P4A_COMMIT" "$ICON" "$ICON_FG" "$ICON_BG" "$APP_VERSION" "$APP_TITLE" <<'PY'
import re, sys
path, p4a_commit, icon, icon_fg, icon_bg, app_version, app_title = sys.argv[1:8]
text = open(path).read()

# --- The launcher label ---------------------------------------------------
#
# `title` only. package.name is deliberately left alone — the deploy tool set
# both from one value, and changing package.name changes the applicationId,
# which makes this a different app that installs beside the old one rather
# than over it.
before = re.search(r'^title\s*=.*$', text, re.M)
text, n = re.subn(r'^title\s*=.*$', f'title = {app_title}', text, flags=re.M)
if n != 1:
    sys.exit(f"error: expected exactly one title line, found {n}")
print("was:", before.group(0) if before else "(absent)")
print(f"now: title = {app_title}")

pkg = re.search(r'^package\.name\s*=.*$', text, re.M)
dom = re.search(r'^package\.domain\s*=.*$', text, re.M)
print(f"     (identity unchanged: {dom.group(0) if dom else '?'} / "
      f"{pkg.group(0) if pkg else '?'})")

# --- Version, and therefore versionCode ----------------------------------
#
# p4a computes versionCode as "10" + min_sdk + version_code, where version_code
# is the dotted version folded into an integer (build.py:424). Leaving this at
# buildozer's stock 0.1 meant every build was versionCode 10211, so no two
# releases were ever an upgrade pair. Bump __version__ to ship an update.
text, n = re.subn(r'^version\s*=.*$', f'version = {app_version}', text, flags=re.M)
if n != 1:
    sys.exit(f"error: expected exactly one version line, found {n}")
print(f"now: version = {app_version}")

# A release build defaults to an .aab (buildozer/target.py:142), which is a
# Play upload format and cannot be sideloaded. Anyone installing from a GitHub
# release needs an .apk.
# Anchored to the `title` line, which is inside [app]. Appending to the end of
# the file instead puts it under the LAST section — [buildozer] — where
# `config.getdefault('app', 'android.release_artifact', 'aab')` cannot see it,
# so it silently falls back to aab and the release build produces a bundle that
# cannot be sideloaded. An ini key in the wrong section is not an error to
# configparser; it is simply a different key.
if re.search(r'^android\.release_artifact\s*=', text, re.M):
    text = re.sub(r'^android\.release_artifact\s*=.*$',
                  'android.release_artifact = apk', text, flags=re.M)
else:
    text, n = re.subn(r'^(title\s*=.*)$',
                      lambda m: m.group(1) + '\n# Sideloadable; the default is aab.'
                                             '\nandroid.release_artifact = apk',
                      text, count=1, flags=re.M)
    if n != 1:
        sys.exit("error: could not anchor android.release_artifact inside [app]")
print("now: android.release_artifact = apk   (in [app])")

before = re.search(r'^android\.permissions\s*=.*$', text, re.M)
text, n = re.subn(r'^android\.permissions\s*=.*$',
                  'android.permissions = android.permission.INTERNET', text, flags=re.M)
if n != 1:
    sys.exit(f"error: expected exactly one android.permissions line, found {n}")
print("was:", before.group(0) if before else "(absent)")
print("now: android.permissions = android.permission.INTERNET")

# p4a.commit may or may not already be present; set it either way.
if re.search(r'^p4a\.commit\s*=.*$', text, re.M):
    text = re.sub(r'^p4a\.commit\s*=.*$', f'p4a.commit = {p4a_commit}', text, flags=re.M)
elif re.search(r'^p4a\.branch\s*=.*$', text, re.M):
    text = re.sub(r'^(p4a\.branch\s*=.*)$', rf'\1\np4a.commit = {p4a_commit}', text, flags=re.M)
else:
    sys.exit("error: no p4a.branch line to anchor p4a.commit to")

# --- The Qt library load order -------------------------------------------
#
# THIS ONE DECIDES WHETHER THE APK BOOTS AT ALL, and it is not a matter of
# taste. p4a renders `--qt-libs` verbatim into res/values/libs.xml, and
# QtLoader dlopens the entries in that order at startup. libQt6Core's
# JNI_OnLoad is what stores the JavaVM pointer that every other Qt library's
# JNI_OnLoad reads back via QJniEnvironment::getJniEnv(). Put Core anywhere
# but first and the first library that touches JNI dereferences a null env:
#
#     F libc: Fatal signal 11 (SIGSEGV), code 1 (SEGV_MAPERR), fault addr 0x0
#             in tid NNNNN (qtMainLoopThrea)
#     #00 QJniEnvironment::getJniEnv()+48   libQt6Core_arm64-v8a.so
#     #02 JNI_OnLoad+68                     libQt6Quick_arm64-v8a.so
#
# It dies on the Qt loader thread before the interpreter starts, so there is
# no Python traceback and nothing in the app's own logs — the only evidence
# is the native tombstone in logcat.
#
# The order is not ours to start with. pyside6-android-deploy builds it as
#
#     self.modules = list(set(modls))     # android_config.py:125
#
# and a set of str iterates in an order that depends on the interpreter's PEP
# 456 hash seed, which is randomised per process. So the load order — and
# therefore whether the build boots — is redrawn on every single build. It
# came up with Core early for months and then, on 2026-09-18, came up
# `QuickControls2,Network,Gui,Core,...` and produced an APK that crashed on
# launch with no source change behind it.
#
# Pinning `modules` in pysidedeploy.spec cannot fix this (see the header:
# Config.__init__ blanks it before AndroidConfig reads it). Rewriting the
# rendered argument here can.
#
# We keep WHAT the scan found and pin only the ORDER, dependencies before
# dependents. Anything unrecognised sorts to the end rather than being
# dropped, so a module added by a future scan still ships — just not first.
QT_LIB_ORDER = ["Core", "Gui", "Network", "OpenGL", "Qml", "Quick",
                "QuickControls2", "WebView"]

found = re.search(r'--qt-libs=(\S+)', text)
if not found:
    sys.exit("error: no --qt-libs in p4a.extra_args; did the bootstrap change?")

libs = found.group(1).split(',')
if "Core" not in libs:
    sys.exit(f"error: Qt Core missing from --qt-libs ({libs}); refusing to build")

ranked = sorted(libs, key=lambda m: (QT_LIB_ORDER.index(m) if m in QT_LIB_ORDER
                                     else len(QT_LIB_ORDER), m))
if ranked[0] != "Core":
    sys.exit(f"error: Core did not sort first ({ranked}); the pin is broken")

unknown = [m for m in libs if m not in QT_LIB_ORDER]
if unknown:
    print(f"note: unranked Qt modules placed last: {unknown}")

print("was: --qt-libs=" + found.group(1))
print("now: --qt-libs=" + ",".join(ranked))
text = text.replace(found.group(0), "--qt-libs=" + ",".join(ranked))

# The launcher icon, for the same reason as the permissions: phase 1 wrote this
# file from scratch, and what it wrote is PySide's stock pyside_icon.jpg — the
# tool has no --icon flag, and it takes the value from the pysidedeploy.spec it
# has just generated itself, so there is no route in except from out here.
before = re.search(r'^icon\.filename\s*=.*$', text, re.M)
text, n = re.subn(r'^icon\.filename\s*=.*$', f'icon.filename = {icon}', text, flags=re.M)
if n != 1:
    sys.exit(f"error: expected exactly one icon.filename line, found {n}")
print("was:", before.group(0) if before else "(absent)")
print(f"now: icon.filename = {icon}")

# The adaptive pair. Unlike icon.filename these keys are not in the generated
# spec at all — pysidedeploy.spec has a single `icon` field and no route for
# them — so they are inserted rather than substituted, anchored after
# icon.filename so they land in the [app] section and not wherever the file
# happens to end.
adaptive = (f'icon.adaptive_foreground.filename = {icon_fg}\n'
            f'icon.adaptive_background.filename = {icon_bg}')
text = re.sub(r'^icon\.adaptive_(foreground|background)\.filename\s*=.*$\n?',
              '', text, flags=re.M)                      # idempotent
anchored, n = re.subn(r'^(icon\.filename\s*=.*)$', lambda m: m.group(1) + '\n' + adaptive,
                      text, count=1, flags=re.M)
if n != 1:
    sys.exit("error: could not anchor the adaptive icon keys to icon.filename")
text = anchored
print(f"now: icon.adaptive_foreground.filename = {icon_fg}")
print(f"now: icon.adaptive_background.filename = {icon_bg}")

open(path, 'w').write(text)
print(f"now: p4a.commit = {p4a_commit}  (CPython 3.11.13)")

# Keep the generated pysidedeploy.spec honest too. It is copied back over the
# project's own copy at the end of the build as "the record of what went into
# the APK", and a record still naming the stock icon would be a lie.
side = 'pysidedeploy.spec'
try:
    spec = open(side).read()
except FileNotFoundError:
    print(f"note: no {side} to update")
else:
    spec, n = re.subn(r'^icon\s*=.*$', f'icon = {icon}', spec, flags=re.M)
    if n == 1:
        open(side, 'w').write(spec)
        print(f"now: {side} icon = {icon}")
    else:
        print(f"note: {n} icon lines in {side}; left alone")
PY

# Phase 1b — put ACLOCAL_PATH back for python-for-android's subprocesses.
#
# p4a builds each recipe's environment from scratch in
# `pythonforandroid/archs.py`: it copies PATH and the HTTP proxy variables and
# nothing else. ACLOCAL_PATH does not survive, and on NixOS that is fatal for
# the libffi recipe, which runs `autoreconf -vif`.
#
# The reason it matters here and not on Ubuntu: aclocal's default macro
# directory is compiled in as automake's own prefix — a /nix/store path that
# contains no libtool macros. The FHS env exposes them at /usr/share/aclocal
# instead, and points ACLOCAL_PATH there. Strip that variable and aclocal
# silently omits libtool.m4 from aclocal.m4, so libffi's AC_PROG_LIBTOOL
# survives unexpanded into `configure` and autoconf rejects it:
#
#     configure.ac:41: error: possibly undefined macro: AC_PROG_LIBTOOL
#
# PATH *is* preserved, so a shim early on PATH restores the variable for every
# aclocal the build runs, without patching p4a.
step "Installing an aclocal shim for python-for-android's scrubbed env"
SHIM="$STAGE/.autotools-shim"
rm -rf "$SHIM"; mkdir -p "$SHIM"
for tool in aclocal libtoolize; do
  real="$(command -v "$tool" || true)"
  [[ -n "$real" ]] || die "$tool not found in the FHS env"
  cat > "$SHIM/$tool" <<EOF
#!/bin/sh
export ACLOCAL_PATH="/usr/share/aclocal\${ACLOCAL_PATH:+:\$ACLOCAL_PATH}"
exec "$real" "\$@"
EOF
  chmod +x "$SHIM/$tool"
done
export PATH="$SHIM:$PATH"
echo "shimmed: $(command -v aclocal)"

# Phase 1c — create the directory python-for-android forgets to.
#
# p4a's adaptive-icon branch writes the descriptor without creating its parent:
#
#     with open(join(res_dir, 'mipmap-anydpi-v26/icon.xml'), "w") as fd:
#
# and the qt bootstrap template ships only `drawable/` and `mipmap/`. Every
# other res write in that file goes through `ensure_dir()` — lines 246, 294,
# 310, 351, 384, 412, 527, 533 — so this one is simply a missed call, and it
# fires the moment both --icon-fg and --icon-bg are passed.
#
# The failure is nasty out of proportion to the cause. p4a copies the two layer
# PNGs, then dies on FileNotFoundError *before* rendering values/libs.xml and
# values/strings.xml, so the dist is left half-written: new icons present, no
# libs.xml at all, no APK. Anything else fixed in the same build — the Qt load
# order, for one — silently never ships.
#
# Patched in the bootstrap template rather than the dist, because p4a recreates
# the dist from the template on every build. The template lives in the p4a
# checkout, which buildozer clones on the first build and reuses thereafter.
P4A_QT_RES="$STAGE/.buildozer/android/platform/python-for-android/pythonforandroid/bootstraps/qt/build/src/main/res"

ensure_anydpi_dir() {
  [[ -d "$P4A_QT_RES" ]] || return 1
  mkdir -p "$P4A_QT_RES/mipmap-anydpi-v26"
  # p4a copies the template with a plain tree copy, and an empty directory does
  # not always survive it; the keep-file guarantees it does.
  : > "$P4A_QT_RES/mipmap-anydpi-v26/.gitkeep"
  return 0
}

# Phase 1d — stop a Play Store policy check from failing a sideloaded build.
#
# `lintVitalRelease` runs on release builds only, and its findings are fatal by
# default. One of them is ExpiredTargetSdkVersion:
#
#     Error: Google Play requires that apps target API level 33 or higher.
#     [ExpiredTargetSdkVersion]  targetSdkVersion 31
#
# gradle exits 1, no artifact is produced, and because the check never runs for
# `debug` the failure appears the first time you try to cut a release — long
# after the thing it complains about was introduced.
#
# The complaint is about *publishing to Play*, which this is not: the APK is
# sideloaded from GitHub, where no target-API floor applies. targetSdkVersion 31
# is a real limitation worth fixing (see §3.2), but it is a deliberate one and
# it should not be able to block a build that was never going to Play.
#
# Only `ExpiredTargetSdkVersion` is suppressed. The rest of lintVital stays
# armed, so a genuine release-only regression still stops the build.
#
# ---- THE RULE THIS FILE LEARNED THE HARD WAY -------------------------------
#
# Do not modify a tracked file inside the python-for-android checkout. Ever.
# buildozer runs, on every single build (targets/android.py:701):
#
#     git reset --hard <p4a.commit>
#
# because this project pins p4a.commit to hold CPython at 3.11. Any edit to a
# file git knows about is silently reverted before the build starts. The first
# attempt at this fix patched build.tmpl.gradle and was undone three times in a
# row, each time looking like the fix simply had not worked.
#
# `reset --hard` does NOT touch untracked files, which is why the phase 1c
# directory below has survived every build. So the lint suppression is a NEW
# file rather than an edit to an existing one.
#
# lint.xml is read automatically by AGP from the gradle module's root
# directory, no build.gradle change required. The bootstrap's build/ directory
# is copied wholesale to become the dist, and the dist root is the module root
# — verified: the phase 1c directory arrives there and p4a writes icon.xml into
# it.
P4A_QT_BUILD="$STAGE/.buildozer/android/platform/python-for-android/pythonforandroid/bootstraps/qt/build"

ensure_lint_exemption() {
  [[ -d "$P4A_QT_BUILD" ]] || return 1
  cat > "$P4A_QT_BUILD/lint.xml" <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<!-- Written by scripts/build-apk (phase 1d). An untracked NEW file on purpose:
     buildozer does `git reset --hard` on this checkout every build, so edits to
     tracked files do not survive and additions do. -->
<lint>
    <!-- A Google Play policy check, fatal by default in lintVitalRelease. This
         APK is sideloaded from GitHub Releases and never uploaded to Play, so
         the target-API floor does not apply to it. -->
    <issue id="ExpiredTargetSdkVersion" severity="ignore" />
</lint>
XML
  return 0
}

if ensure_lint_exemption; then
  step "Wrote p4a's qt bootstrap lint.xml: ExpiredTargetSdkVersion ignored"
  LINT_PATCHED=1
else
  printf '\033[33mnote:\033[0m p4a not cloned yet; lint.xml written after the clone.\n'
  LINT_PATCHED=0
fi

if ensure_anydpi_dir; then
  step "Patched p4a's qt bootstrap: res/mipmap-anydpi-v26 exists"
  ANYDPI_PATCHED=1
else
  # Cold build: buildozer has not cloned python-for-android yet, so there is
  # nothing to patch. Phase 2 retries once after the clone appears.
  printf '\033[33mnote:\033[0m python-for-android not cloned yet; will patch after the clone.\n'
  ANYDPI_PATCHED=0
fi

# Phase 2 — the actual build. This is what pyside6-android-deploy would have
# run itself; invoking it directly is what lets the edits above take effect.
step "Running buildozer"
# Deliberately not `set -e`-fatal on its own. With no TTY attached buildozer
# finishes the packaging, prints "# Android packaging done!", and *then* exits
# non-zero after failing to restore terminal state ("stty: 'standard input':
# Inappropriate ioctl for device"). Trusting its exit code alone throws away a
# perfectly good APK. The presence of the APK is the real success test, and it
# is checked immediately below, so a genuine failure is still caught.
# A marker to date the APK against. Anything older than this is left over from
# an earlier build and must not be shipped — see the staleness check below.
STAMP="$STAGE/.build-started"
: > "$STAMP"

# --- Why SOURCE_DATE_EPOCH is unset for this command ------------------------
#
# It is what makes `adb install -r` actually replace the app's code.
#
# The bootstrap does not re-extract assets/private.tar on every launch. It
# compares a stamp baked into the APK against files/app/private.version and
# extracts only when they differ (PythonUtil.unpackAsset). The stamp is
#
#     sha1("{version} {numeric_version} {timestamp}")        build.py:595
#
# and all three parts are constants here:
#
#     version         0.1        from the generated buildozer.spec
#     numeric_version 10211      "10" + min_sdk(21) + version_code(1)
#     timestamp       315532800  SOURCE_DATE_EPOCH — 1980-01-01
#
# That last one is the problem. Nix's stdenv exports SOURCE_DATE_EPOCH for
# reproducible builds, `nix develop` inherits it, and build.py prefers it over
# the wall clock. So the stamp is the same hash on every build forever:
#
#     sha1("0.1 10211 315532800") = 463cf0e3c4f3e09a34aa591298bf7001fae14d04
#
# — which is exactly what was found in files/app/private.version on the device.
# Install a new APK and the bootstrap compares equal, skips extraction, and
# runs the OLD code out of files/app. New Python, new QML, new everything:
# ignored, silently, with the new APK sitting right there.
#
# Unsetting it restores the wall clock, so every build gets a distinct stamp
# and every install refreshes the code by itself.
#
# This does NOT sign you out. unpackAsset deletes files/app only; the session
# lives in files/mycu/session.json, which is untouched. That makes this
# strictly better than the `pm clear` this project used to recommend, which
# wipes everything including the login.
#
# The cost is that the APK is no longer bit-reproducible. It is a debug build
# signed with a throwaway key; nothing here depends on that.
BUILD_MODE=debug
(( DO_RELEASE )) && BUILD_MODE=release

BUILDOZER_RC=0
env -u SOURCE_DATE_EPOCH python3 -m buildozer android "$BUILD_MODE" || BUILDOZER_RC=$?

# Cold build: the clone now exists, so the bootstrap can be patched. Retry once
# rather than making the user run the whole thing again.
if (( BUILDOZER_RC != 0 && (ANYDPI_PATCHED == 0 || LINT_PATCHED == 0) )) \
   && ensure_anydpi_dir && ensure_lint_exemption; then
  step "Patched p4a's qt bootstrap and retrying the build once"
  ANYDPI_PATCHED=1
  LINT_PATCHED=1
  : > "$STAMP"
  BUILDOZER_RC=0
  env -u SOURCE_DATE_EPOCH python3 -m buildozer android "$BUILD_MODE" || BUILDOZER_RC=$?
fi

cd "$ROOT"

# buildozer reports "available in the bin directory" but actually leaves the
# file in its working directory, so look in both.
#
# `-newer $STAMP` is the important part and it is load-bearing. The exit code
# cannot be trusted (see the note above), so the presence of an APK is used as
# the success test — but "an APK exists" is true even when this build produced
# nothing, because the previous build's APK is still sitting there. On
# 2026-09-18 that shipped a known-crashing APK from a build forty minutes
# earlier, reinstalled it, and reported success: two real fixes appeared to
# have done nothing, and the evidence that the build had failed was forty
# thousand lines up the scrollback.
APK="$(find "$STAGE" -maxdepth 2 -name '*.apk' -newer "$STAMP" -print 2>/dev/null | sort | tail -1)"
if [[ -z "$APK" ]]; then
  STALE="$(find "$STAGE" -maxdepth 2 -name '*.apk' -print 2>/dev/null | sort | tail -1)"
  die "buildozer exited $BUILDOZER_RC and produced no APK in this run.
   ${STALE:+An older APK is present at $STALE — it is NOT this build and has
   not been installed. }Scroll up for the real error; a Python traceback from
   python-for-android is the usual cause."
fi
if (( BUILDOZER_RC != 0 )); then
  printf '\033[33mnote:\033[0m buildozer exited %d but produced a fresh APK; continuing.\n' "$BUILDOZER_RC"
fi

# Release artifacts get their own name and keep the version in it. A release
# APK and a debug APK are signed with different keys and will not install over
# one another, so having both land on mycu.apk is a way to publish the wrong
# file exactly once.
if (( DO_RELEASE )); then
  OUT_APK="$ROOT/cedarview-${APP_VERSION}-arm64-v8a.apk"
else
  OUT_APK="$ROOT/mycu.apk"
fi

cp "$APK" "$OUT_APK"
step "Built $(du -h "$OUT_APK" | cut -f1) -> $OUT_APK"

if (( DO_RELEASE )); then
  # An unsigned release APK installs nowhere, and buildozer only warns. Check
  # the artifact itself rather than trusting that the env vars were honoured.
  if unzip -l "$OUT_APK" 2>/dev/null | grep -qiE 'META-INF/.*\.(RSA|DSA|EC)$'; then
    echo "signature block present"
  else
    die "the release APK is UNSIGNED and no device will install it.
   buildozer drops --sign silently when any P4A_RELEASE_* variable is missing.
   Do not publish $OUT_APK."
  fi
fi

# Verify that the CPython bundled in the APK is the one shiboken actually links
# against. Getting this wrong produces an APK that builds, installs and then
# dies instantly on launch with an UnsatisfiedLinkError that never reaches
# Python, so it is worth one second of zipfile reading here.
step "Checking the bundled libpython matches shiboken's DT_NEEDED"
python3 - "$ROOT/mycu.apk" "$WHEEL_SHIBOKEN" <<'PY'
import re, sys, zipfile

apk, shiboken_wheel = sys.argv[1], sys.argv[2]

blob = zipfile.ZipFile(shiboken_wheel).read('shiboken6/libshiboken6.abi3.so')
needed = sorted({m.decode() for m in re.findall(rb'libpython[0-9.]+\.so', blob)})
if not needed:
    print("shiboken links no libpython explicitly; nothing to check")
    raise SystemExit(0)

bundled = sorted({n.rsplit('/', 1)[-1]
                  for n in zipfile.ZipFile(apk).namelist()
                  if re.search(r'libpython[0-9.]+\.so$', n)})
print("shiboken needs:", ", ".join(needed))
print("apk bundles:   ", ", ".join(bundled) or "(none)")

missing = [n for n in needed if n not in bundled]
if missing:
    raise SystemExit(
        f"error: the APK does not bundle {missing}. It will install and then "
        f"crash at startup with UnsatisfiedLinkError. Fix P4A_COMMIT in this "
        f"script so python-for-android builds the matching CPython."
    )
print("ok")
PY

# Verify the shipped manifest, not the spec we edited. A permission creeping
# back in is exactly the kind of thing that should fail the build rather than
# be noticed later in the app's settings page.
AAPT="$(find "$SDK_ROOT/build-tools" -name 'aapt' -type f 2>/dev/null | sort | tail -1)"
if [[ -n "$AAPT" ]]; then
  step "Permissions in the built APK"
  PERMS="$("$AAPT" dump permissions "$ROOT/mycu.apk" 2>/dev/null | grep -oE 'android\.permission\.[A-Z_]+' | sort -u)"
  echo "${PERMS:-(none)}"
  UNEXPECTED="$(grep -v '^android\.permission\.INTERNET$' <<<"$PERMS" || true)"
  [[ -z "$UNEXPECTED" ]] || die "unexpected permissions in the APK:
$UNEXPECTED
   The permission pinning in phase 1a did not take. Do not install this build."
else
  printf '\033[33mwarning:\033[0m aapt not found; APK permissions unverified.\n'
fi

# The generated spec is the record of what actually went into the APK — module
# list, plugins, permissions. Keep a copy next to the APK for inspection.
[[ -f "$STAGE/pysidedeploy.spec" ]] && cp "$STAGE/pysidedeploy.spec" "$ROOT/pysidedeploy.spec"

# --- Install ----------------------------------------------------------------

if (( DO_INSTALL )); then
  # The stamp currently on the device, read before installing. If the new APK
  # carries the same one the bootstrap will skip extraction and keep running
  # the old code — the failure this whole dance exists to prevent — so it is
  # worth the half second to be able to say so afterwards.
  OLD_STAMP="$(adb shell run-as org.mycu.mycu cat files/app/private.version 2>/dev/null | tr -d '\r' || true)"

  step "Installing"
  adb install -r "$ROOT/mycu.apk"
  # The stamp is only rewritten once the app has launched and extracted, so
  # this reports what to expect rather than what happened.
  # private_version is the only 40-hex string in the resource table — checked
  # with `strings | sort -u`, one value, equal to the device's. Cheaper and
  # more portable than shelling out to aapt, which is not always on PATH here.
  NEW_STAMP="$(unzip -p "$ROOT/mycu.apk" resources.arsc 2>/dev/null \
               | strings 2>/dev/null | grep -oE '\b[0-9a-f]{40}\b' | head -1 || true)"
  if [[ -n "$OLD_STAMP" && -n "$NEW_STAMP" && "$OLD_STAMP" == "$NEW_STAMP" ]]; then
    printf '\033[31mwarning:\033[0m the APK carries the same data stamp as the\n'
    printf '         copy already on the device (%s).\n' "$OLD_STAMP"
    printf '         files/app will NOT be re-extracted and the app will keep\n'
    printf '         running its old code. Force it with:\n\n'
    printf '             adb shell pm clear org.mycu.mycu   # also signs you out\n\n'
  else
    printf 'data stamp %s -> %s; files/app will be re-extracted on first launch.\n' \
      "${OLD_STAMP:-(none)}" "${NEW_STAMP:-(unreadable)}"
  fi

  cat <<'EOF'

Now watch it start. "Extracting private assets." is the line that confirms the
new code actually landed:

    adb logcat -c && adb logcat | grep -iE 'python|qml|mycu|Extracting'

Things flagged for on-device verification are marked '# VERIFY:' in the source
and listed in docs/android.md.
EOF
else
  cat <<EOF

Install it with:

    adb install -r $ROOT/mycu.apk
    adb logcat -c && adb logcat | grep -iE 'python|qml|mycu'
EOF
fi
