# --- Secrets. Nothing here is recoverable or safe to publish. ---
# Release signing keystore for the APK. Losing it means you can never ship an
# upgrade to an already-installed build. Back it up OUTSIDE this repo.
*.keystore
*.jks
keystore.properties

# Captured HAR files and raw responses from M0 discovery: these contain live
# session cookies, your student ID and your name. Scrub before promoting a body
# into tests/fixtures/.
docs/captures/
*.har

# Persisted session state (cookies). App-private storage only.
.session/

# --- Build / tooling ---
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.buildozer/
.buildozer-home/
# ~1 GB of PySide6 Android wheels, created by scripts/build-apk inside the FHS
# shell. Rebuildable from pyproject.toml; never belongs in the repo.
.venv-android/
# The Android-target PySide6/shiboken6 wheels (~80 MB), fetched from
# download.qt.io. Redownloadable; see docs/android.md.
.android-wheels/
# NDK/SDK cache created by pyside6-android-deploy.
.pyside6_android_deploy/
bin/
deployment/
*.apk
*.aab
.direnv/
result
result-*
# Staging copy of the project that scripts/build-apk hands to
# pyside6-android-deploy (see the header of that script).
android-build/
