#!/usr/bin/env bash
# Android build driver.
#
#   nix develop --command cedarview-android-build -c ./scripts/build-apk [flags]
#
# (`cedarview-android-build` is the FHS shell from flake.nix; everything the
# Android build runs — the NDK's clang, Gradle's JVM, the SDK tools and the
# host Qt tools — is a prebuilt Linux binary that expects one.)
#
# Flags:
#   --install        adb install -r the result onto the connected device afterwards
#   --clean          throw away build-android/ first
#   --release        a release APK signed with your key, for GitHub Releases
#   --aab            a release App Bundle signed with your key, for Google Play
#                    (implies --release)
#   --out-dir DIR    where --release/--aab copy their artifact (default: the
#                    repo root). Use a scratch directory for any build signed
#                    with a throwaway key — see "Signing" below.
#
# What it does, in order:
#
#   1. Re-runs itself with a clean environment (see "Why env -i").
#   2. Checks the SDK, the NDK and the signing variables.
#   3. Fetches the Qt Android kit into .qt/ with aqtinstall, once.
#   4. Configures CMakeLists.txt with the kit's qt-cmake into build-android/,
#      and builds the `apk` or `aab` target — androiddeployqt and Gradle.
#   5. Runs the gates over the artifact that will actually ship: signature,
#      16 KB alignment, the manifest (identity, API levels, back-gesture
#      opt-out, INTERNET as the only permission, not debuggable), and for a
#      bundle the download size Play will measure.
#   6. Copies a --release/--aab artifact to the output directory, and installs.
#
# There is no Python in the APK any more. The app is C++ (src/) and QML (qml/),
# and the APK holds Qt's libraries and libcedarview. This script used to be
# ~1,400 lines of buildozer, python-for-android and shiboken workarounds; none
# of them apply now. See docs/android.md for the history, if you need it.
#
# ---------------------------------------------------------------------------
# Signing
# ---------------------------------------------------------------------------
#
# Every artifact is signed, because an unsigned APK installs nowhere:
#
#   default     ~/.android/debug.keystore (created if missing) — the same key
#               Gradle has always used for debug builds, so `adb install -r`
#               replaces an earlier debug install instead of refusing it.
#   --release   your release key, from
#   --aab         QT_ANDROID_KEYSTORE_PATH       (alias P4A_RELEASE_KEYSTORE)
#                 QT_ANDROID_KEYSTORE_ALIAS      (alias P4A_RELEASE_KEYALIAS)
#                 QT_ANDROID_KEYSTORE_STORE_PASS (alias P4A_RELEASE_KEYSTORE_PASSWD)
#                 QT_ANDROID_KEYSTORE_KEY_PASS   (alias P4A_RELEASE_KEYALIAS_PASSWD)
#               The P4A_RELEASE_* names are what this project used before the
#               move to C++, so an existing setup keeps working unchanged.
#
# The first --aab you upload to Google Play fixes your upload key for good. An
# AAB signed with any other key — a throwaway one used to test this script, say
# — must never end up where it could be uploaded, which is why --out-dir
# exists: point a test build at a scratch directory, never the repo root.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }
die()  { printf '\033[31merror:\033[0m %s\n' "$1" >&2; exit 1; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$1"; }

# --- Why env -i --------------------------------------------------------------
#
# The FHS shell is entered from the nix devShell, and inherits all of it: the
# desktop Qt's directories on PATH, NIXPKGS_CMAKE_PREFIX_PATH, CMAKE_*_PATH,
# QT_PLUGIN_PATH, NIX_CFLAGS_COMPILE. CMake's package search walks PATH, so
# find_package(Qt6) inside the Android toolchain then finds the *desktop* Qt
# and dies in Qt6CoreConfigExtras.cmake with a wall of include() errors. The
# fix is not to unset a list of variables (the next nixpkgs adds another) but
# to start from nothing and add back what the build needs.

[[ -n "${CEDARVIEW_ANDROID_FHS:-}" ]] || die \
  "not inside the Android FHS shell. Run it as
       nix develop --command cedarview-android-build -c ./scripts/build-apk
   The NDK, Gradle and the host Qt tools are prebuilt Linux binaries that need
   an FHS layout; the plain devShell cannot provide one. See docs/android.md."

if [[ -z "${CEDARVIEW_CLEAN_ENV:-}" ]]; then
  keep=()
  for v in JAVA_HOME ANDROID_SDK_ROOT ANDROID_NDK_ROOT \
           QT_ANDROID_KEYSTORE_PATH QT_ANDROID_KEYSTORE_ALIAS \
           QT_ANDROID_KEYSTORE_STORE_PASS QT_ANDROID_KEYSTORE_KEY_PASS \
           P4A_RELEASE_KEYSTORE P4A_RELEASE_KEYALIAS \
           P4A_RELEASE_KEYSTORE_PASSWD P4A_RELEASE_KEYALIAS_PASSWD \
           ANDROID_SERIAL; do
    [[ -n "${!v:-}" ]] && keep+=("$v=${!v}")
  done
  exec env -i HOME="$HOME" USER="${USER:-}" TERM="${TERM:-dumb}" LANG="${LANG:-C.UTF-8}" \
    PATH=/usr/bin:/bin CEDARVIEW_ANDROID_FHS=1 CEDARVIEW_CLEAN_ENV=1 "${keep[@]}" \
    bash "${BASH_SOURCE[0]}" "$@"
fi

# --- Flags -------------------------------------------------------------------

DO_INSTALL=0
DO_CLEAN=0
DO_RELEASE=0
DO_AAB=0
OUT_DIR="$ROOT"
while (( $# )); do
  case "$1" in
    --install) DO_INSTALL=1 ;;
    --clean)   DO_CLEAN=1 ;;
    --release) DO_RELEASE=1 ;;
    --aab)     DO_AAB=1; DO_RELEASE=1 ;;
    --out-dir) shift; [[ $# -gt 0 ]] || die "--out-dir needs a directory"; OUT_DIR="$1" ;;
    *) die "unknown flag: $1" ;;
  esac
  shift
done
mkdir -p "$OUT_DIR"
OUT_DIR="$(cd "$OUT_DIR" && pwd)"

# --- Pins --------------------------------------------------------------------

# The Qt release. It must be the one the desktop devShell uses (flake.nix /
# flake.lock), so the QML that is tested on the desktop is the QML that ships.
QT_VERSION="6.11.1"
AQT_VERSION="3.3.0"
QT_DIR="$ROOT/.qt"
QT_ANDROID="$QT_DIR/$QT_VERSION/android_arm64_v8a"
QT_HOST="$QT_DIR/$QT_VERSION/gcc_64"

# Qt 6.11's official Android binaries are built with NDK r27c; the app must be
# built with the same one.
NDK_REVISION_PREFIX="27.2."

# What the gates below expect of the built manifest. They are set in
# CMakeLists.txt; restated here because the point of a gate is to check the
# result against an independent statement of intent.
APP_ID="com.kromakobra.cedarview"
TARGET_SDK=36
MIN_SDK=28

BUILD="$ROOT/build-android"

APP_VERSION="$(sed -n 's/^project(CedarView VERSION \([0-9.]*\).*/\1/p' CMakeLists.txt)"
[[ -n "$APP_VERSION" ]] || die "could not read the version from project() in CMakeLists.txt"

# --- Preconditions -----------------------------------------------------------

step "Checking preconditions"

command -v java >/dev/null || die "no JDK on PATH (expected inside the FHS env)"
[[ -n "${JAVA_HOME:-}" ]] || die "JAVA_HOME is not set (flake.nix's FHS profile sets it)"
command -v cmake >/dev/null && command -v ninja >/dev/null || die "cmake and ninja are needed (FHS env)"

# The SDK and NDK the Python build downloaded are reused as they are.
SDK_ROOT="${ANDROID_SDK_ROOT:-$HOME/.buildozer/android/platform/android-sdk}"
NDK_ROOT="${ANDROID_NDK_ROOT:-$HOME/.pyside6_android_deploy/android-ndk/android-ndk-r27c}"
[[ -d "$SDK_ROOT/platforms/android-$TARGET_SDK" ]] || die \
  "the Android SDK at $SDK_ROOT has no platforms/android-$TARGET_SDK.
   Set ANDROID_SDK_ROOT, or install it with sdkmanager \"platforms;android-$TARGET_SDK\"."
BUILD_TOOLS="$(find "$SDK_ROOT/build-tools" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -V | tail -1)"
[[ -n "$BUILD_TOOLS" ]] || die "no build-tools under $SDK_ROOT/build-tools"
NDK_REV="$(sed -n 's/^Pkg.Revision *= *//p' "$NDK_ROOT/source.properties" 2>/dev/null || true)"
[[ "$NDK_REV" == "$NDK_REVISION_PREFIX"* ]] || die \
  "the NDK at $NDK_ROOT is '${NDK_REV:-missing}', but Qt $QT_VERSION for Android is built
   with r27c ($NDK_REVISION_PREFIX*). Set ANDROID_NDK_ROOT to an r27c install."
echo "SDK $SDK_ROOT (build-tools $(basename "$BUILD_TOOLS")), NDK $NDK_REV"

if (( DO_RELEASE )); then
  : "${QT_ANDROID_KEYSTORE_PATH:=${P4A_RELEASE_KEYSTORE:-}}"
  : "${QT_ANDROID_KEYSTORE_ALIAS:=${P4A_RELEASE_KEYALIAS:-}}"
  : "${QT_ANDROID_KEYSTORE_STORE_PASS:=${P4A_RELEASE_KEYSTORE_PASSWD:-}}"
  : "${QT_ANDROID_KEYSTORE_KEY_PASS:=${P4A_RELEASE_KEYALIAS_PASSWD:-}}"
  for v in QT_ANDROID_KEYSTORE_PATH QT_ANDROID_KEYSTORE_ALIAS \
           QT_ANDROID_KEYSTORE_STORE_PASS QT_ANDROID_KEYSTORE_KEY_PASS; do
    [[ -n "${!v:-}" ]] || die \
      "--release needs \$$v set (or its P4A_RELEASE_* alias).
   See the 'Signing' notes at the top of this script, and
   docs/iterating-and-shipping.md for generating the keystore."
  done
  [[ -f "$QT_ANDROID_KEYSTORE_PATH" ]] || die "keystore not found: $QT_ANDROID_KEYSTORE_PATH"
else
  # The debug key. Gradle creates this on the first debug build of anything;
  # create it the same way if this machine has never had one.
  DEBUG_KEYSTORE="$HOME/.android/debug.keystore"
  if [[ ! -f "$DEBUG_KEYSTORE" ]]; then
    mkdir -p "$HOME/.android"
    keytool -genkeypair -keystore "$DEBUG_KEYSTORE" -storepass android -keypass android \
      -alias androiddebugkey -keyalg RSA -keysize 2048 -validity 10000 \
      -dname "CN=Android Debug,O=Android,C=US" >/dev/null
  fi
  QT_ANDROID_KEYSTORE_PATH="$DEBUG_KEYSTORE"
  QT_ANDROID_KEYSTORE_ALIAS=androiddebugkey
  QT_ANDROID_KEYSTORE_STORE_PASS=android
  QT_ANDROID_KEYSTORE_KEY_PASS=android
fi
export QT_ANDROID_KEYSTORE_PATH QT_ANDROID_KEYSTORE_ALIAS \
       QT_ANDROID_KEYSTORE_STORE_PASS QT_ANDROID_KEYSTORE_KEY_PASS

if (( DO_AAB )); then
  command -v bundletool >/dev/null || die \
    "--aab needs bundletool on PATH, to read the bundle's manifest and to turn it into
   installable APKs. It is in flake.nix's FHS env; re-enter the shell."
fi

if (( DO_INSTALL )); then
  if ! command -v adb >/dev/null; then
    warn "adb not on PATH; --install unavailable."
    DO_INSTALL=0
  elif ! adb devices | tail -n +2 | grep -q $'\tdevice$'; then
    warn "no authorised device visible to adb. The build will still run. If the
         phone shows as \"unauthorized\", unlock it and accept the RSA prompt."
    DO_INSTALL=0
  fi
fi
echo "ok"

if (( DO_CLEAN )); then
  step "Cleaning"
  rm -rf "$BUILD"
fi

# --- Toolchain ---------------------------------------------------------------
#
# Two Qt kits, both from download.qt.io via aqtinstall, into the gitignored
# .qt/: the Android one (with QtWebView, which the login and the transport
# need), and a desktop one of the same version, whose host tools (moc, rcc,
# qmlcachegen, androiddeployqt) the Android build runs. aqtinstall is a host
# tool in a venv under .qt/ and never goes near the APK.

if [[ ! -f "$QT_ANDROID/bin/qt-cmake" || ! -f "$QT_ANDROID/lib/cmake/Qt6WebView/Qt6WebViewConfig.cmake" \
      || ! -x "$QT_HOST/bin/androiddeployqt" ]]; then
  step "Fetching Qt $QT_VERSION for Android (once; about 2 GB)"
  mkdir -p "$QT_DIR"
  if [[ ! -x "$QT_DIR/aqt-venv/bin/aqt" ]]; then
    python3 -m venv "$QT_DIR/aqt-venv"
    "$QT_DIR/aqt-venv/bin/pip" install --quiet "aqtinstall==$AQT_VERSION"
  fi
  # Run from inside .qt/, because aqt drops its aqtinstall.log in the current
  # directory.
  (
    cd "$QT_DIR"
    aqt-venv/bin/aqt install-qt linux desktop "$QT_VERSION" linux_gcc_64 --outputdir .
    # From Qt 6.8 on, the Android kits are published under the `all_os` host.
    aqt-venv/bin/aqt install-qt all_os android "$QT_VERSION" android_arm64_v8a -m qtwebview --outputdir .
  )
fi

# --- Configure and build -----------------------------------------------------

step "Configuring"
SIGN_APK=ON
SIGN_AAB=OFF
TARGET=apk
if (( DO_AAB )); then SIGN_APK=OFF; SIGN_AAB=ON; TARGET=aab; fi

# -Wno-deprecated: the NDK's own toolchain files still ask for CMake < 3.5,
# which CMake 4 warns about on every configure; nothing here can fix that.
"$QT_ANDROID/bin/qt-cmake" -S "$ROOT" -B "$BUILD" -G Ninja -Wno-deprecated \
  -DCMAKE_BUILD_TYPE=Release \
  -DQT_HOST_PATH="$QT_HOST" \
  -DANDROID_SDK_ROOT="$SDK_ROOT" \
  -DANDROID_NDK_ROOT="$NDK_ROOT" \
  -DANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES=ON \
  -DQT_ANDROID_SIGN_APK="$SIGN_APK" \
  -DQT_ANDROID_SIGN_AAB="$SIGN_AAB" \
  >/dev/null

step "Building the $TARGET"
# The artifact's presence, and its age, are the success test — not just the
# exit code. Anything older than this stamp is left over from an earlier build
# and must not be shipped: that once installed a known-crashing APK from forty
# minutes before and reported success.
STAMP="$BUILD/.build-started"
: > "$STAMP"
# The apk target is tracked by this one output file, so with no code change
# ninja calls it up to date and androiddeployqt never runs — no fresh APK, and,
# worse, no re-signing when you switch between the debug key and --release.
# Removing it makes packaging and signing run every time; that is ~10 seconds.
# (The aab target has no such file and always runs.)
rm -f "$BUILD/android-build/cedarview.apk"
cmake --build "$BUILD" --target "$TARGET"

# The release variant only: the aab target builds a debug bundle beside it,
# unsigned, which must never be the one picked up.
if (( DO_AAB )); then
  ARTIFACT="$(find "$BUILD/android-build/build/outputs/bundle/release" -name '*.aab' -newer "$STAMP" 2>/dev/null | sort | tail -1)"
else
  ARTIFACT="$(find "$BUILD/android-build/build/outputs/apk/release" -name '*-signed.apk' -newer "$STAMP" 2>/dev/null | sort | tail -1)"
fi
[[ -n "$ARTIFACT" ]] || die "the build produced no signed .$TARGET in this run. Scroll up for the error."

# Release artifacts get their own name and keep the version in it. A release
# APK and a debug APK are signed with different keys and will not install over
# one another, so giving them one name is a way to publish the wrong file.
if (( DO_AAB )); then
  OUT="$OUT_DIR/cedarview-${APP_VERSION}.aab"
elif (( DO_RELEASE )); then
  OUT="$OUT_DIR/cedarview-${APP_VERSION}-arm64-v8a.apk"
else
  OUT="$BUILD/cedarview-${APP_VERSION}-arm64-v8a-debug.apk"
fi
cp "$ARTIFACT" "$OUT"
step "Built $(du -h "$OUT" | cut -f1) -> $OUT"

# --- Gates -------------------------------------------------------------------
#
# Every check reads $OUT, the file that will actually ship.

step "Checking the signature"
# An .aab is signed the jarsigner way, so it carries a META-INF/*.RSA (or .EC)
# block. An APK at minSdk >= 24 carries APK Signature Scheme v2+, which lives
# in the zip's signing block, not META-INF — apksigner reads the real thing.
if (( DO_AAB )); then
  # Not `grep -q`: it stops reading at the first match, unzip dies of SIGPIPE,
  # and under pipefail a signed bundle then reads as unsigned.
  unzip -Z1 "$OUT" 2>/dev/null | grep -iE '^META-INF/[^/]+\.(RSA|DSA|EC)$' >/dev/null \
    || die "the bundle is UNSIGNED; Play will not accept it. Do not upload $OUT."
else
  "$BUILD_TOOLS/apksigner" verify "$OUT" >/dev/null \
    || die "the APK is not validly signed; no device will install it. Do not publish $OUT."
fi
echo "ok"

# Play refuses the upload otherwise, and a 16 KB-page phone refuses to load a
# 4 KB-aligned library.
step "Checking every native library is 16 KB-aligned"
python3 - "$OUT" <<'PY'
import struct, sys, zipfile

PAGE = 0x4000


def min_load_align(blob):
    e_phoff, = struct.unpack_from('<Q', blob, 0x20)
    e_phentsize, e_phnum = struct.unpack_from('<HH', blob, 0x36)
    aligns = []
    for i in range(e_phnum):
        off = e_phoff + i * e_phentsize
        if struct.unpack_from('<I', blob, off)[0] == 1:          # PT_LOAD
            aligns.append(struct.unpack_from('<Q', blob, off + 48)[0])
    return min(aligns)


bad, checked = [], 0
with zipfile.ZipFile(sys.argv[1]) as z:
    for name in z.namelist():
        # lib/<abi>/ in an APK, base/lib/<abi>/ in a bundle.
        if not name.endswith('.so') or '/lib/' not in f'/{name}':
            continue
        blob = z.read(name)
        if blob[:4] != b'\x7fELF':
            continue
        checked += 1
        if min_load_align(blob) < PAGE:
            bad.append(name)

print(f"{checked} ELF files checked")
if not checked:
    raise SystemExit("error: no native libraries found — the package layout has changed?")
if bad:
    print("\n".join(f"  4 KB-aligned: {b}" for b in bad))
    raise SystemExit(
        f"error: {len(bad)} native libraries are not 16 KB-aligned. Google Play "
        f"rejects the upload, and 16 KB-page phones cannot load them.")
print("ok")
PY
if (( ! DO_AAB )); then
  # The ELF segments are only half of it: an uncompressed library must also
  # start on a 16 KB boundary inside the zip, or it cannot be mapped in place.
  "$BUILD_TOOLS/zipalign" -c -P 16 -v 4 "$OUT" >/dev/null \
    || die "the APK's native libraries are not 16 KB-aligned in the zip (zipalign -c -P 16)."
  echo "zip alignment ok"
fi

# The shipped manifest, not the one in android/: the identity, the API levels
# Play checks, the back-gesture opt-out, that it is not debuggable, and that
# INTERNET is the only permission. A permission creeping back in is exactly
# the kind of thing that should fail the build rather than be noticed later in
# the app's settings page.
step "Checking the built manifest"
if (( DO_AAB )); then
  MANIFEST_DUMP="$(bundletool dump manifest --bundle "$OUT")"
  MANIFEST_KIND=xml
else
  MANIFEST_DUMP="$("$BUILD_TOOLS/aapt" dump xmltree "$OUT" AndroidManifest.xml)"
  MANIFEST_KIND=aapt
fi
MANIFEST_DUMP="$MANIFEST_DUMP" \
python3 - "$MANIFEST_KIND" "$APP_ID" "$TARGET_SDK" "$MIN_SDK" <<'PY'
import os, re, sys
kind, app_id, api, minapi = sys.argv[1:5]
dump = os.environ["MANIFEST_DUMP"]

if kind == "xml":
    import xml.etree.ElementTree as ET
    A = "{http://schemas.android.com/apk/res/android}"
    root = ET.fromstring(dump)
    sdk = root.find("uses-sdk")
    app = root.find("application")
    got = {
        "package": root.get("package"),
        "minSdk": sdk.get(A + "minSdkVersion"),
        "targetSdk": sdk.get(A + "targetSdkVersion"),
        "debuggable": app.get(A + "debuggable") == "true",
        "backCallback": app.get(A + "enableOnBackInvokedCallback"),
        "permissions": sorted(e.get(A + "name") for e in root.findall("uses-permission")),
    }
else:
    # aapt's xmltree: attributes as  A: android:name(0x...)=(type 0x10)0x24
    # for integers and booleans, or ="value" (Raw: ...) for strings.
    def attr(name):
        m = re.search(rf'A: (?:android:)?{name}(?:\(0x[0-9a-f]+\))?=(?:\(type 0x[0-9a-f]+\)0x([0-9a-f]+)|"([^"]*)")', dump)
        if not m:
            return None
        return str(int(m.group(1), 16)) if m.group(1) is not None else m.group(2)
    back = attr("enableOnBackInvokedCallback")
    got = {
        "package": attr("package"),
        "minSdk": attr("minSdkVersion"),
        "targetSdk": attr("targetSdkVersion"),
        "debuggable": attr("debuggable") not in (None, "0"),
        "backCallback": None if back is None else ("false" if back == "0" else "true"),
        "permissions": sorted(set(re.findall(
            r'E: uses-permission.*?\n\s+A: android:name\(0x[0-9a-f]+\)="([^"]+)"', dump))),
    }

expected = {
    "package": app_id,
    "minSdk": minapi,
    "targetSdk": api,
    "debuggable": False,
    "backCallback": "false",
    "permissions": ["android.permission.INTERNET"],
}

for key in got:
    print(f"  {key:13} {got[key]}")
wrong = {k: (got.get(k), v) for k, v in expected.items() if got.get(k) != v}
if wrong:
    raise SystemExit("error: the built manifest is not what android/AndroidManifest.xml and "
                     "CMakeLists.txt intend:\n" + "\n".join(
        f"  {k}: got {g!r}, expected {e!r}" for k, (g, e) in wrong.items()))
print("ok")
PY

# An App Bundle is not installable as-is: Play turns it into split APKs per
# device. bundletool does the same thing locally, which gives both the size
# Play will measure and something that installs exactly the way a Play
# download would — the thing to test on the phone before uploading.
if (( DO_AAB )); then
  APKS="$OUT_DIR/cedarview-${APP_VERSION}.apks"
  step "Generating the APK set Play would serve, and its download size"
  bundletool build-apks --overwrite \
    --bundle="$OUT" --output="$APKS" \
    --ks="$QT_ANDROID_KEYSTORE_PATH" \
    --ks-pass="file:"<(printf '%s' "$QT_ANDROID_KEYSTORE_STORE_PASS") \
    --ks-key-alias="$QT_ANDROID_KEYSTORE_ALIAS" \
    --key-pass="file:"<(printf '%s' "$QT_ANDROID_KEYSTORE_KEY_PASS")
  SIZE_CSV="$(bundletool get-size total --apks="$APKS")"
  echo "$SIZE_CSV"
  # MIN,MAX in bytes, compressed download size. Play's cap on the compressed
  # download of an app's base module is 200 MB. bundletool ends its lines
  # with \r\n, hence the tr.
  MAX_BYTES="$(tail -1 <<<"$SIZE_CSV" | cut -d, -f2 | tr -dc '0-9')"
  if [[ "$MAX_BYTES" =~ ^[0-9]+$ ]]; then
    printf 'largest download: %d MB (Play cap: 200 MB)\n' $(( MAX_BYTES / 1000000 ))
    (( MAX_BYTES <= 200000000 )) || die "the download is over Play's 200 MB cap."
  else
    warn "could not read the size from bundletool; check it by hand."
  fi
fi

# --- Install -----------------------------------------------------------------

if (( DO_INSTALL && DO_AAB )); then
  # Installs the split APKs for this particular phone, as Play would.
  step "Installing the bundle's APK set"
  bundletool install-apks --apks="$APKS"
elif (( DO_INSTALL )); then
  step "Installing"
  adb install -r "$OUT"
fi

if (( DO_INSTALL )); then
  cat <<EOF

Installed $APP_ID. Watch it start:

    adb logcat -c && adb logcat | grep -iE 'mycu|qml|cedarview'
EOF
elif (( DO_AAB )); then
  cat <<EOF

Upload $OUT to Play Console. To try it first, exactly as Play would install it:

    bundletool install-apks --apks=$APKS
EOF
else
  cat <<EOF

Install it with:

    adb install -r $OUT
    adb logcat -c && adb logcat | grep -iE 'mycu|qml|cedarview'
EOF
fi
