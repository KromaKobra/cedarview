# --- Secrets. Nothing here is recoverable or safe to publish. ---
# Release signing keystore for the APK. Losing it means you can never ship an
# upgrade to an already-installed build. Back it up OUTSIDE this repo.
*.keystore
*.jks
keystore.properties

# Captured HAR files and raw responses from discovery: these contain live
# session cookies, your student ID and your name. Scrub before promoting a body
# into tests/fixtures/.
docs/captures/
*.har

# Persisted session state (cookies). App-private storage only.
.session/

# --- Build / tooling ---
# CMake build trees: build/ (desktop) and build-android/ (scripts/build-apk).
build*/
# The Qt Android and host kits, and the aqtinstall venv that fetches them
# (~2 GB, all redownloadable; scripts/build-apk does it on first run).
.qt/
# Python bytecode from the desktop dev scripts (scripts/devkit.py and friends).
__pycache__/
*.py[cod]
*.apk
*.aab
# The split-APK set scripts/build-apk --aab generates from a bundle.
*.apks
.direnv/
result
result-*

# Written by scripts/make-icon-layers every time the icon is regenerated. It is
# a look-at-it-and-decide check, not an asset.
assetignore/

# Release signing material, in case it is ever kept beside the project rather
# than in ~/keys. Committing it would hand anyone the ability to publish an
# update that installs over yours.
*.pass
